const section2App3BgImage = heroData.section2_application_3_bg_image || 'https://images.unsplash.com/photo-1474487548417-781cb71495f3?auto=format&fit=crop&w=2000&q=80';
const section2App3Icon = heroData.section2_application_3_icon || '';
const section2App3TitleCn = heroData.section2_application_3_title_cn || '轨道交通';
