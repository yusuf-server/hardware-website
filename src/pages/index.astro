---

<MainLayout title="ARESTUN - Precision CNC Tools & Machining Solution" hideFooter={true}>
  <Header />

  <!-- 右上角页码指示器 -->
  <div class="fixed top-7 right-8 z-40 text-xs font-mono text-gray-400 flex items-center gap-1 transition-opacity duration-500">
    <span id="current-page" class="text-white font-bold text-sm">01</span>
    <span class="text-gray-600">/ 06</span>
  </div>

  <!-- 侧边指示点 -->
  <div class="fixed right-6 top-1/2 -translate-y-1/2 z-40 flex flex-col items-center gap-3 transition-opacity duration-500">
    <button onclick="scrollToSection(1)" class="dot-indicator w-2.5 h-2.5 rounded-full bg-blue-500 transition-all duration-300 shadow-[0_0_8px_#3b82f6]" data-index="1" title="Section 1"></button>
    <button onclick="scrollToSection(2)" class="dot-indicator w-2 h-2 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300" data-index="2" title="Section 2"></button>
    <button onclick="scrollToSection(3)" class="dot-indicator w-2 h-2 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300" data-index="3" title="Section 3"></button>
    <button onclick="scrollToSection(4)" class="dot-indicator w-2 h-2 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300" data-index="4" title="Section 4"></button>
    <button onclick="scrollToSection(5)" class="dot-indicator w-2 h-2 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300" data-index="5" title="Section 5"></button>
    <button onclick="scrollToSection(6)" class="dot-indicator w-2 h-2 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300" data-index="6" title="Section 6"></button>
  </div>

  <!-- 下一页引导悬浮按钮 -->
  <button onclick="scrollNext()" class="fixed bottom-8 right-8 z-40 w-10 h-10 rounded-full border border-white/15 flex items-center justify-center bg-black/40 backdrop-blur hover:border-white/40 transition-all duration-500">
    <i data-lucide="chevron-down" class="w-4 h-4 text-gray-300"></i>
  </button>

  <main id="main-scroll" class="snap-container">

    <!-- Section 1: Hero -->
    <section id="section-1" class="snap-section relative flex items-center justify-between px-8 md:px-16 pt-20 overflow-hidden bg-[#06080d]">
      <div id="hero-bg-0" class="hero-bg-layer active absolute inset-0 bg-cover bg-center transition-opacity duration-700"
           style={`background-image: url('${heroBg1}'); opacity: 0.5;`}></div>
      <div id="hero-bg-1" class="hero-bg-layer absolute inset-0 bg-cover bg-center transition-opacity duration-700"
           style={`background-image: url('${heroBg2}'); opacity: 0;`}></div>
      <div id="hero-bg-2" class="hero-bg-layer absolute inset-0 bg-cover bg-center transition-opacity duration-700"
           style={`background-image: url('${heroBg3}'); opacity: 0;`}></div>

      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl pl-0 lg:pl-[120px]">
        <div class="flex items-center gap-2.5 mb-6 text-xs md:text-sm font-mono tracking-wider uppercase">
          <span class="text-blue-500 font-bold text-base select-none">/</span>
          <span class="text-gray-300 tracking-wider font-medium">{heroSubtitle}</span>
        </div>

        <h1 class="hero-main-heading mb-6 tracking-tight leading-[0.98]">
          <span class="block text-white font-black">{heroTitle1}</span>
          <span class="block text-white font-black">{heroTitle2}</span>
          <span class="block text-[#1d63ed] font-black">{heroTitle3}</span>
          <span class="block text-[#1d63ed] font-black">{heroTitle4}</span>
        </h1>

        <p class="text-gray-300/90 text-sm md:text-base leading-relaxed max-w-xl mb-10 font-normal">
          {heroDescription}
        </p>

        <button class="motion-hero-button group relative h-14 w-52 cursor-pointer rounded-full border-none p-1 outline-none bg-white overflow-visible">
          <span class="motion-circle absolute top-1 left-1 bg-blue-600 block h-12 w-12 rounded-full transition-all duration-500 ease-in-out group-hover:w-[calc(100%-0.5rem)]"></span>
          <div class="motion-icon absolute top-1/2 left-5 -translate-y-1/2 transition-transform duration-500 ease-in-out group-hover:translate-x-2 z-10">
            <i data-lucide="arrow-right" class="w-6 h-6 text-white"></i>
          </div>
          <span class="motion-text absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 ml-4 text-gray-900 text-lg font-medium tracking-tight whitespace-nowrap transition-colors duration-500 ease-in-out group-hover:text-white z-10" style="font-weight: 900;">
            {heroButtonText}
          </span>
        </button>
      </div>

      <div class="relative z-10 w-full max-w-xl flex flex-col gap-5 self-center pb-4 ml-8 pr-0 lg:pr-[200px]">
        <div class="flex items-center justify-between text-[11px] font-mono tracking-wider text-gray-400 border-b border-white/10 pb-2">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
            <span class="text-blue-400 font-medium">NOW SOURCING</span>
          </div>
          <div class="text-gray-400">2026 · ARESTUN TOOL</div>
        </div>

        <div class="text-[11px] font-mono text-gray-400 tracking-widest uppercase">
          — DISCOVER PERFORMANCE TOOLS
        </div>

        <div class="flex flex-col gap-3">
          <div class="glass-card group relative flex items-center justify-between p-5 md:px-6 md:py-5 rounded-2xl cursor-pointer overflow-hidden transition-all hover:ring-2 hover:ring-blue-500/50"
               data-hero-bg="0"
               onmouseenter="switchHeroBg(0)">
            <img src={thumbBg1} alt={productCard1Title} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-r from-[#060a12]/90 via-[#060a12]/75 to-[#060a12]/40 group-hover:via-[#060a12]/60 transition-colors pointer-events-none"></div>

            <div class="relative z-10 flex flex-col gap-1">
              <span class="text-[12px] font-mono text-blue-400 font-semibold uppercase tracking-wider block">{productCard1Category}</span>
              <h4 class="text-lg md:text-xl font-bold text-white tracking-wide group-hover:text-blue-200 transition-colors">{productCard1Title}</h4>
            </div>

