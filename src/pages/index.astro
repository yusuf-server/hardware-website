---
import MainLayout from '@/layouts/MainLayout.astro';
import { getFeaturedProducts, getCategories } from '@/lib/woocommerce';
import { getHomePage } from '@/lib/wordpress';

let featuredProducts = [];
let categories = [];
let homePageData = null;

try {
  console.log('🔴 Starting data fetch...');

  // 分别获取数据，方便调试
  const productsPromise = getFeaturedProducts(6).catch(err => {
    console.error('❌ getFeaturedProducts failed:', err);
    return [];
  });

  const categoriesPromise = getCategories().catch(err => {
    console.error('❌ getCategories failed:', err);
    return [];
  });

  const homePagePromise = getHomePage().catch(err => {
    console.error('❌ getHomePage failed:', err);
    return null;
  });

  [featuredProducts, categories, homePageData] = await Promise.all([
    productsPromise,
    categoriesPromise,
    homePagePromise
  ]);

  console.log('🟢 Data fetch completed');
  console.log('index.astro - homePageData received:', homePageData ? 'YES' : 'NO');
  console.log('index.astro - homePageData ID:', homePageData?.id);
  console.log('index.astro - homePageData type:', typeof homePageData);
  console.log('index.astro - homePageData:', homePageData);
  console.log('index.astro - homePageData.acf exists:', homePageData?.acf ? 'YES' : 'NO');
  if (homePageData?.acf) {
    console.log('index.astro - homePageData.acf keys:', Object.keys(homePageData.acf));
  }
} catch (e) {
  console.error('❌ Error fetching data:', e);
}

// 提取 ACF 数据，提供默认值
const heroData = homePageData?.acf || {};
console.log('index.astro - heroData:', heroData);

// 辅助函数：处理图片字段（可能是对象、ID 或空字符串）
function getImageUrl(field: any, defaultUrl: string): string {
  if (!field) return defaultUrl;
  if (typeof field === 'object' && field.url) return field.url;
  if (typeof field === 'number') {
    // 如果是图片 ID，构建 WordPress 媒体 URL（这是临时方案，理想情况应该用 _embed 参数）
    return defaultUrl; // 暂时使用默认图片
  }
  if (typeof field === 'string' && field.startsWith('http')) return field;
  return defaultUrl;
}

// 背景图片（提供默认值）
const heroBg1 = getImageUrl(heroData.hero_background_image_1, 'https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=1800&q=80');
const heroBg2 = getImageUrl(heroData.hero_background_image_2, 'https://images.unsplash.com/photo-1572635196237-14b3f281503f?auto=format&fit=crop&w=1800&q=80');
const heroBg3 = getImageUrl(heroData.hero_background_image_3, 'https://images.unsplash.com/photo-1577803645773-f96470509666?auto=format&fit=crop&w=1800&q=80');

// 缩略图（使用相同的图片）
const thumbBg1 = getImageUrl(heroData.hero_background_image_1, 'https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=200&q=80');
const thumbBg2 = getImageUrl(heroData.hero_background_image_2, 'https://images.unsplash.com/photo-1572635196237-14b3f281503f?auto=format&fit=crop&w=200&q=80');
const thumbBg3 = getImageUrl(heroData.hero_background_image_3, 'https://images.unsplash.com/photo-1577803645773-f96470509666?auto=format&fit=crop&w=200&q=80');

// 调试：在服务器端打印完整的 ACF 数据
console.log('=== ACF Data Debug ===');
console.log('Full ACF Data:', JSON.stringify(heroData, null, 2));
console.log('hero_subtitle:', heroData.hero_subtitle);
console.log('hero_title_line_1:', heroData.hero_title_line_1);
console.log('hero_title_line1:', heroData.hero_title_line1);
console.log('hero_title_line2:', heroData.hero_title_line2);
console.log('hero_title_line3:', heroData.hero_title_line3);
console.log('hero_title_line4:', heroData.hero_title_line4);
console.log('=====================');

// 文字内容（提供默认值）- 支持两种字段名格式
const heroSubtitle = heroData.hero_subtitle || 'LUMENLAB — SS28 DROP 01';
const heroTitle1 = heroData.hero_title_line_1 || heroData.hero_title_line1 || '20 YEARS';
const heroTitle2 = heroData.hero_title_line2 || 'EXPERIENCE';
const heroTitle3 = heroData.hero_title_line3 || 'IN TOOLS';
const heroTitle4 = heroData.hero_title_line4 || 'MANUFACTURING';
const heroButtonText = heroData.hero_button_text || 'Get Started';

// 产品卡片内容（提供默认值）
const productCard1Category = heroData.product_card_1_category || '01 — Sunglasses';
const productCard1Title = heroData.product_card_1_title || 'Solar Flare Aviator';

const productCard2Category = heroData.product_card_2_category || '02 — Sunglasses';
const productCard2Title = heroData.product_card_2_title || 'Neon Cat-Eye';

const productCard3Category = heroData.product_card_3_category || '03 — Sunglasses';
const productCard3Title = heroData.product_card_3_title || 'Shield Runway';

// Section 2 - 应用领域内容
const section2TitleCn = heroData.section2_title_cn || '应用领域';
const section2TitleEn = heroData.section2_title_en || 'APPLICATION AREA';

const section2App1BgImage = heroData.section2_application_1_bg_image || 'https://images.unsplash.com/photo-1540959733332-eab4deabeeaf?auto=format&fit=crop&w=2000&q=80';
const section2App1Icon = heroData.section2_application_1_icon || '';
const section2App1TitleCn = heroData.section2_application_1_title_cn || '航空航天';
const section2App1TitleEn = heroData.section2_application_1_title_en || 'Aerospace';
