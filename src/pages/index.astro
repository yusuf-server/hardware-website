const section2App2BgImage = heroData.section2_application_2_bg_image || 'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=2000&q=80';
const section2App2Icon = heroData.section2_application_2_icon || '';
const section2App2TitleCn = heroData.section2_application_2_title_cn || '汽车行业';
const section2App2TitleEn = heroData.section2_application_2_title_en || 'Motor-dom';
