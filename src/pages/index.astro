const section2App4BgImage = heroData.section2_application_4_bg_image || 'https://images.unsplash.com/photo-1558441719-57353529f7f0?auto=format&fit=crop&w=2000&q=80';
const section2App4Icon = heroData.section2_application_4_icon || '';
const section2App4TitleCn = heroData.section2_application_4_title_cn || '新能源';
const section2App4TitleEn = heroData.section2_application_4_title_en || 'New Energy';
const section2App4Link = heroData.section2_application_4_link || '#';

const section2App5BgImage = heroData.section2_application_5_bg_image || 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=2000&q=80';
const section2App5Icon = heroData.section2_application_5_icon || '';
const section2App5TitleCn = heroData.section2_application_5_title_cn || '模具制造行业';
const section2App5TitleEn = heroData.section2_application_5_title_en || 'Mold Manufacturing';
const section2App5Link = heroData.section2_application_5_link || '#';

const section2App6BgImage = heroData.section2_application_6_bg_image || 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=2000&q=80';
const section2App6Icon = heroData.section2_application_6_icon || '';
const section2App6TitleCn = heroData.section2_application_6_title_cn || '3C行业';
const section2App6TitleEn = heroData.section2_application_6_title_en || '3C Industry';
const section2App6Link = heroData.section2_application_6_link || '#';

const section2FooterLeft = heroData.section2_footer_left || 'GLOBAL INDUSTRY PRECISION SOLUTIONS';
const section2FooterRight = heroData.section2_footer_right || 'HOVER EACH VERTICAL TO EXPLORE';

// Section 3: Company Information (Part 1)
const section3Tab1Icon = heroData.section3_tab_1_icon || 'building';
const section3Tab1Title = heroData.section3_tab_1_title || 'Company Information';
const section3Tab2Icon = heroData.section3_tab_2_icon || 'star';
const section3Tab2Title = heroData.section3_tab_2_title || 'Modular System';
const section3Tab3Icon = heroData.section3_tab_3_icon || 'factory';
const section3Tab3Title = heroData.section3_tab_3_title || 'Production Process';

const section3Panel1VideoUrl = heroData.section3_panel_1_video || '/videos/33-1.mp4';
const section3Panel1VideoPoster = getImageUrl(
  heroData.section3_panel_1_poster,
  'https://images.unsplash.com/photo-1581092918484-8313e1f7e8d6?auto=format&fit=crop&w=800&q=80'
);
const section3Panel1Title = heroData.section3_panel_1_title || 'Who We Are';
const section3Panel1Description = heroData.section3_panel_1_content ||
  'We are a professional manufacturer specializing in the production of hardware products including labor, quantity and cutting tools in Zhejiang province, China, and have operated offline physical stores for more than 20 years. Factory direct sales, massive inventory, integrity management, quality assurance.';
const section3Panel1ButtonText = heroData.section3_panel_1_button_text || 'Read More';
const section3Panel1ButtonLink = heroData.section3_panel_1_button_link || '/about';

// Section 4: Background Image and Gallery
const section4BackgroundImage = getImageUrl(
  heroData.section4_background_image,
  'https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=1800&q=80'
);

// Section 4: Gallery Images (图片集)
const section4GalleryImages = heroData.section4_gallery_images || [];

// 默认图片（如果 ACF 没有数据）
const defaultGalleryImages = [
  'https://images.unsplash.com/photo-1581092918484-8313e1f7e8d6?auto=format&fit=crop&w=600&q=80',
  'https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=600&q=80',
  'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=600&q=80',
  'https://images.unsplash.com/photo-1565793298595-6a879b1d9492?auto=format&fit=crop&w=600&q=80',
  'https://images.unsplash.com/photo-1572635196243-4dd75fbdbd7f?auto=format&fit=crop&w=600&q=80',
  'https://images.unsplash.com/photo-1581092918484-8313e1f7e8d6?auto=format&fit=crop&w=600&q=80',
  'https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=600&q=80'
];

// 处理图片集：如果 ACF 有数据则使用，否则使用默认图片
// 因为 return_format 是 "url"，所以直接是 URL 字符串数组
const galleryImages = section4GalleryImages && section4GalleryImages.length > 0
  ? section4GalleryImages
  : defaultGalleryImages;

// Section 5: Testimonials (客户评价)
const section5BackgroundVideo = heroData.section5_background_video || 'https://assets.mixkit.co/videos/preview/mixkit-stars-in-space-1610-large.mp4';
const section5Title = heroData.section5_title || 'Customer Satisfaction Is<br>Our Greatest Achievement';
const section5Testimonials = heroData.section5_testimonials || [
  {
    quote: "We've been working with this supplier for over 3 years. Their quality control is impeccable, and they always deliver on time. Highly recommended for precision manufacturing needs.",
    avatar: "https://i.pravatar.cc/120?img=12",
    name: "David Chen",
    title: "Supply Chain Manager, TechCorp Inc.",
    grayscale: false
  },
  {
    quote: "Outstanding service and product quality. They understand our requirements perfectly and provide excellent technical support throughout the entire process.",
    avatar: "https://i.pravatar.cc/120?img=32",
    name: "Sarah Johnson",
    title: "Operations Director, Global Manufacturing",
    grayscale: true
  },
  {
    quote: "Professional team with deep industry knowledge. They helped us optimize our tool selection, resulting in 30% cost savings without compromising quality.",
    avatar: "https://i.pravatar.cc/120?img=15",
    name: "Michael Zhang",
    title: "Production Manager, Precision Parts Ltd.",
    grayscale: false
  },
  {
    quote: "Reliable partner for our manufacturing operations. Their inventory management and quick response time have significantly improved our production efficiency.",
    avatar: "https://i.pravatar.cc/120?img=28",
    name: "Emily Wang",
    title: "CEO, Innovation Tools Co.",
    grayscale: true
  }
];

// 打印最终使用的值（可选，生产环境可删除）
console.log('ACF data loaded successfully');
---

<MainLayout title="LUMENLAB - One Page Demo">
  <!-- 顶部导航栏 -->
  <header class="fixed top-0 left-0 w-full z-50 flex items-center justify-between px-8 py-5 backdrop-blur-md bg-[#06080d]/70 border-b border-white/10">
    <a href="/" class="flex items-center gap-2 text-xl tracking-wider" style="font-weight: 700;">
      <div class="w-7 h-7 rounded-lg bg-blue-600 flex items-center justify-center shadow-lg shadow-blue-500/25">
        <i data-lucide="sparkles" class="w-4 h-4 text-white"></i>
      </div>
      <span class="tracking-widest font-syne text-lg text-white" style="font-weight: 700;">LUMENLAB</span>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm text-gray-400" style="font-weight: 400;">
      <a href="/" class="hover:text-white transition-colors duration-200" style="font-weight: 300;">Home</a>
      <a href="/about" class="hover:text-white transition-colors duration-200" style="font-weight: 300;">About</a>
      <a href="/products" class="hover:text-white transition-colors duration-200" style="font-weight: 300;">Products</a>
      <a href="/applications" class="hover:text-white transition-colors duration-200" style="font-weight: 300;">Applications</a>
      <a href="/news" class="hover:text-white transition-colors duration-200" style="font-weight: 300;">News</a>
      <a href="/contact" class="hover:text-white transition-colors duration-200" style="font-weight: 300;">Contact</a>
    </nav>

    <div class="flex items-center gap-4">
      <button class="flex items-center gap-1.5 text-xs text-gray-300 hover:text-white px-3 py-1.5 rounded-full border border-white/10 hover:border-white/20 transition-all" style="font-weight: 400;">
        <i data-lucide="globe" class="w-3.5 h-3.5"></i>
        <span style="font-weight: 400;">EN</span>
      </button>
      <a href="/contact" class="text-xs px-5 py-2.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white shadow-lg shadow-blue-500/25 transition-all" style="font-weight: 600;">
        Get Quote
      </a>
    </div>
  </header>

  <!-- 右上角页码指示器 -->
  <div class="fixed top-7 right-8 z-40 text-xs font-mono text-gray-400 flex items-center gap-1">
    <span id="current-page" class="text-white font-bold text-sm">01</span>
    <span class="text-gray-600">/ 08</span>
  </div>

  <!-- 侧边指示点 -->
  <div class="fixed right-6 top-1/2 -translate-y-1/2 z-40 flex flex-col items-center gap-3">
    <button onclick="scrollToSection(1)" class="dot-indicator w-2.5 h-2.5 rounded-full bg-blue-500 transition-all duration-300 shadow-[0_0_8px_#3b82f6]" data-index="1" title="Section 1"></button>
    <button onclick="scrollToSection(2)" class="dot-indicator w-2 h-2 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300" data-index="2" title="Section 2"></button>
    <button onclick="scrollToSection(3)" class="dot-indicator w-2 h-2 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300" data-index="3" title="Section 3"></button>
    <button onclick="scrollToSection(4)" class="dot-indicator w-2 h-2 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300" data-index="4" title="Section 4"></button>
    <button onclick="scrollToSection(5)" class="dot-indicator w-2 h-2 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300" data-index="5" title="Section 5"></button>
    <button onclick="scrollToSection(6)" class="dot-indicator w-2 h-2 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300" data-index="6" title="Section 6"></button>
  </div>

  <!-- 下一页引导悬浮按钮 -->
  <button onclick="scrollNext()" class="fixed bottom-8 right-8 z-40 w-10 h-10 rounded-full border border-white/15 flex items-center justify-center bg-black/40 backdrop-blur hover:border-white/40 transition-all">
    <i data-lucide="chevron-down" class="w-4 h-4 text-gray-300"></i>
  </button>

  <main id="main-scroll" class="snap-container">

    <!-- Section 1: Hero -->
    <section id="section-1" class="snap-section relative flex items-center justify-between px-8 md:px-16 pt-20 overflow-hidden bg-[#06080d]">
      <!-- 多个背景层，通过 class 控制显示 - 动态背景图片 -->
      <div id="hero-bg-0" class="hero-bg-layer active absolute inset-0 bg-cover bg-center transition-opacity duration-700"
           style={`background-image: url('${heroBg1}'); opacity: 0.5;`}></div>
      <div id="hero-bg-1" class="hero-bg-layer absolute inset-0 bg-cover bg-center transition-opacity duration-700"
           style={`background-image: url('${heroBg2}'); opacity: 0;`}></div>
      <div id="hero-bg-2" class="hero-bg-layer absolute inset-0 bg-cover bg-center transition-opacity duration-700"
           style={`background-image: url('${heroBg3}'); opacity: 0;`}></div>

      <!-- 轻微的暗色遮罩，保证文字可读性 -->
      <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-black/40 to-transparent pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl">
        <div class="flex items-center gap-3 mb-6 text-xs font-mono tracking-widest text-blue-400 uppercase">
          <span class="text-blue-500 font-bold">§ 01</span>
          <span class="text-gray-600">|</span>
          <!-- 动态副标题 -->
          <span class="text-gray-400 tracking-wider">{heroSubtitle}</span>
        </div>

        <!-- 动态标题 -->
        <h1 class="text-[3rem] md:text-[4.5rem] lg:text-[5.5rem] leading-[0.95] tracking-tighter mb-10" style="font-family: Impact, 'Arial Black', sans-serif; font-weight: 900;">
          <span class="block text-white" style="font-weight: 900;">{heroTitle1}</span>
          <span class="block text-white" style="font-weight: 900;">{heroTitle2}</span>
          <span class="block text-gray-400" style="font-weight: 400;">{heroTitle3}</span>
          <span class="block text-gray-400" style="font-weight: 400;">{heroTitle4}</span>
        </h1>

        <!-- 动态按钮文字 -->
        <button class="motion-hero-button group relative h-14 w-52 cursor-pointer rounded-full border-none p-1 outline-none bg-white overflow-visible">
          <span class="motion-circle absolute top-1 left-1 bg-blue-600 block h-12 w-12 rounded-full transition-all duration-500 ease-in-out group-hover:w-[calc(100%-0.5rem)]"></span>
          <div class="motion-icon absolute top-1/2 left-5 -translate-y-1/2 transition-transform duration-500 ease-in-out group-hover:translate-x-2 z-10">
            <i data-lucide="arrow-right" class="w-6 h-6 text-white"></i>
          </div>
          <span class="motion-text absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 ml-4 text-gray-900 text-lg font-medium tracking-tight whitespace-nowrap transition-colors duration-500 ease-in-out group-hover:text-white z-10" style="font-weight: 500;">
            {heroButtonText}
          </span>
        </button>
      </div>

      <div class="relative z-10 w-full max-w-xl flex flex-col gap-5 self-center pb-4 ml-8">
        <div class="flex items-center justify-between text-[11px] font-mono tracking-wider text-gray-400 border-b border-white/10 pb-2">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
            <span class="text-blue-400 font-medium">NOW SOURCING</span>
          </div>
          <div class="text-gray-400">2026 · LINHAI · CN</div>
        </div>

        <div class="text-[11px] font-mono text-gray-400 tracking-widest uppercase">
          — FEATURED THIS DROP
        </div>

        <div class="flex flex-col gap-3">
          <div class="glass-card group flex items-center justify-between p-4 rounded-2xl cursor-pointer transition-all hover:ring-2 hover:ring-blue-500/50"
               data-hero-bg="0"
               onmouseenter="switchHeroBg(0)">
            <div class="flex items-center gap-4">
              <div class="w-20 h-16 rounded-xl overflow-hidden bg-neutral-900 flex-shrink-0">
                <img src={thumbBg1} alt={productCard1Title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
              </div>
              <div>
                <span class="text-[11px] font-mono text-blue-400 uppercase tracking-wider block">{productCard1Category}</span>
                <h4 class="text-base font-semibold text-white group-hover:text-blue-300 transition-colors">{productCard1Title}</h4>
              </div>
            </div>
            <i data-lucide="arrow-right" class="w-5 h-5 text-gray-400 group-hover:translate-x-1 group-hover:text-white transition-all"></i>
          </div>

          <div class="glass-card group flex items-center justify-between p-4 rounded-2xl cursor-pointer transition-all hover:ring-2 hover:ring-blue-500/50"
               data-hero-bg="1"
               onmouseenter="switchHeroBg(1)">
            <div class="flex items-center gap-4">
              <div class="w-20 h-16 rounded-xl overflow-hidden bg-neutral-900 flex-shrink-0">
                <img src={thumbBg2} alt={productCard2Title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
              </div>
              <div>
                <span class="text-[11px] font-mono text-blue-400 uppercase tracking-wider block">{productCard2Category}</span>
                <h4 class="text-base font-semibold text-white group-hover:text-blue-300 transition-colors">{productCard2Title}</h4>
              </div>
            </div>
            <i data-lucide="arrow-right" class="w-5 h-5 text-gray-400 group-hover:translate-x-1 group-hover:text-white transition-all"></i>
          </div>

          <div class="glass-card-active group flex items-center justify-between p-4 rounded-2xl cursor-pointer transition-all hover:ring-2 hover:ring-blue-500/50"
               data-hero-bg="2"
               onmouseenter="switchHeroBg(2)">
            <div class="flex items-center gap-4">
              <div class="w-20 h-16 rounded-xl overflow-hidden bg-neutral-900 flex-shrink-0 ring-1 ring-blue-500/50">
                <img src={thumbBg3} alt={productCard3Title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
              </div>
              <div>
                <span class="text-[11px] font-mono text-blue-400 uppercase tracking-wider block font-medium">{productCard3Category}</span>
                <h4 class="text-base font-semibold text-white">{productCard3Title}</h4>
              </div>
            </div>
            <i data-lucide="arrow-right" class="w-5 h-5 text-blue-400 group-hover:translate-x-1 transition-all"></i>
          </div>
        </div>
      </div>
    </section>

