  <script is:inline>
    const container = document.getElementById('main-scroll');
    const sections = document.querySelectorAll('.snap-section');
    const dots = document.querySelectorAll('.dot-indicator');
    const pageNumber = document.getElementById('current-page');
    const pageNumberContainer = document.querySelector('.fixed.top-7.right-8');
    const dotsContainer = document.querySelector('.fixed.right-6.top-1\\/2');
    const nextButton = document.querySelector('.fixed.bottom-8.right-8');

    function scrollToSection(index) {
      const target = document.getElementById(`section-${index}`);
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
      }
    }

    function scrollNext() {
      const currentIndex = Math.round(container.scrollTop / window.innerHeight) + 1;
      const nextIndex = currentIndex >= sections.length ? 1 : currentIndex + 1;
      scrollToSection(nextIndex);
    }

    // 监听全屏滑动，同步右上角与右侧导航点
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          const index = parseInt(id.replace('section-', ''));

          pageNumber.textContent = String(index).padStart(2, '0');

          dots.forEach(dot => {
            const dotIdx = parseInt(dot.getAttribute('data-index'));
            if (dotIdx === index) {
              dot.className = "dot-indicator w-2.5 h-2.5 rounded-full bg-blue-500 transition-all duration-300 shadow-[0_0_8px_#3b82f6]";
            } else {
              dot.className = "dot-indicator w-2 h-2 rounded-full bg-white/30 hover:bg-white/60 transition-all duration-300";
            }
          });
        }
      });
    }, {
      root: container,
      threshold: 0.55
    });

    sections.forEach(sec => observer.observe(sec));

    // 监听滚动到底部时隐藏导航元素（监听 container 内的滚动）
    container.addEventListener('scroll', () => {
      const scrollTop = container.scrollTop;
      const scrollHeight = container.scrollHeight;
      const clientHeight = container.clientHeight;

      // 当滚动到接近底部时（距离底部小于 100px）
      if (scrollHeight - scrollTop - clientHeight < 100) {
        // 隐藏导航元素
        if (pageNumberContainer) pageNumberContainer.style.opacity = '0';
        if (dotsContainer) dotsContainer.style.opacity = '0';
        if (nextButton) nextButton.style.opacity = '0';
      } else {
        // 显示导航元素
        if (pageNumberContainer) pageNumberContainer.style.opacity = '1';
        if (dotsContainer) dotsContainer.style.opacity = '1';
        if (nextButton) nextButton.style.opacity = '1';
      }
    });

    // Section 3: Hero Tab 切换逻辑
    const heroTabs = [
      document.getElementById('hero-tab-0'),
      document.getElementById('hero-tab-1'),
      document.getElementById('hero-tab-2'),
      document.getElementById('hero-tab-3')
    ];

    const heroPanels = [
      document.getElementById('hero-panel-0'),
      document.getElementById('hero-panel-1'),
      document.getElementById('hero-panel-2'),
      document.getElementById('hero-panel-3')
    ];

    const indicatorBar = document.querySelector('.indicator-bar');

    function switchHeroTab(index) {
      heroTabs.forEach((tab, i) => {
        if (i === index) {
          tab.classList.add('active');
        } else {
          tab.classList.remove('active');
        }
      });

      heroPanels.forEach((panel, i) => {
        if (i === index) {
          panel.classList.add('active');
        } else {
          panel.classList.remove('active');
        }
      });

      // 更新指示器位置
      if (heroTabs[index] && indicatorBar) {
        const tabWidth = heroTabs[index].offsetWidth;
        const tabLeft = heroTabs[index].offsetLeft;
        indicatorBar.style.width = tabWidth + 'px';
        indicatorBar.style.left = tabLeft + 'px';
      }
    }

    // 初始化指示器位置
    if (heroTabs[0] && indicatorBar) {
      indicatorBar.style.width = heroTabs[0].offsetWidth + 'px';
      indicatorBar.style.left = heroTabs[0].offsetLeft + 'px';
    }

    // Section 5: CNC Tab 鼠标 Hover 切换逻辑
    const tabButtons = document.querySelectorAll('.cnc-tab-btn');
    const contentPanels = document.querySelectorAll('.tab-content-panel');
    const imagePanels = document.querySelectorAll('.tab-image-panel');

    function switchCncTab(index) {
      tabButtons.forEach(btn => {
        if (btn.getAttribute('data-tab') === String(index)) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      contentPanels.forEach((panel, i) => {
        if (i === index) {
          panel.classList.add('active');
        } else {
          panel.classList.remove('active');
        }
      });

      imagePanels.forEach((panel, i) => {
        if (i === index) {
          panel.classList.add('active');
        } else {
          panel.classList.remove('active');
        }
      });
    }

    tabButtons.forEach(btn => {
      btn.addEventListener('mouseenter', () => {
        const tabIndex = parseInt(btn.getAttribute('data-tab'));
        switchCncTab(tabIndex);
      });
    });

    // Section 6: 应用领域交互逻辑
    const appCols = document.querySelectorAll('.app-col');
    const appBgs = document.querySelectorAll('.app-bg-layer');

    function activateAppColumn(index) {
      appBgs.forEach((bg, i) => {
        if (i === index) {
          bg.classList.add('active');
        } else {
          bg.classList.remove('active');
        }
      });

      appCols.forEach((col, i) => {
        if (i === index) {
          col.classList.add('active');
        } else {
          col.classList.remove('active');
        }
      });
    }

    appCols.forEach(col => {
      col.addEventListener('mouseenter', () => {
        const idx = parseInt(col.getAttribute('data-app-index'));
        activateAppColumn(idx);
      });
    });

    // Section 7: Testimonials 左右切换逻辑
    let currentTestiSlide = 0;
    const testiSlides = [
      document.getElementById('testi-slide-0'),
      document.getElementById('testi-slide-1')
    ];

    function showTestimonialSlide(index, direction = 'next') {
      testiSlides.forEach((slide, i) => {
        if (i === index) {
          // 新进入的 slide
          slide.style.transform = direction === 'next' ? 'translateX(100%)' : 'translateX(-100%)';
          slide.style.opacity = '0';
          slide.classList.add('active');

          // 使用 requestAnimationFrame 确保动画流畅
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              slide.style.transform = 'translateX(0)';
              slide.style.opacity = '1';
            });
          });
        } else if (slide.classList.contains('active')) {
          // 正在退出的 slide
          slide.style.transform = direction === 'next' ? 'translateX(-100%)' : 'translateX(100%)';
          slide.style.opacity = '0';

          // 动画结束后移除 active
          setTimeout(() => {
            slide.classList.remove('active');
          }, 600); // 与 CSS transition 时间一致
        }
      });
    }

    function prevTestimonial() {
      currentTestiSlide = (currentTestiSlide - 1 + testiSlides.length) % testiSlides.length;
      showTestimonialSlide(currentTestiSlide, 'prev');
    }

    function nextTestimonial() {
      currentTestiSlide = (currentTestiSlide + 1) % testiSlides.length;
      showTestimonialSlide(currentTestiSlide, 'next');
    }

    window.scrollToSection = scrollToSection;
    window.scrollNext = scrollNext;
    window.prevTestimonial = prevTestimonial;
    window.nextTestimonial = nextTestimonial;
    window.switchHeroTab = switchHeroTab;

    // Hero background switching function
    function switchHeroBg(index) {
      const bgLayers = document.querySelectorAll('.hero-bg-layer');

      bgLayers.forEach((layer, i) => {
        if (i === index) {
          layer.style.opacity = '0.5';
        } else {
          layer.style.opacity = '0';
        }
      });
    }

    window.switchHeroBg = switchHeroBg;

    // Coverflow carousel functionality - 真正的无限循环
    const coverflowTrack = document.getElementById('coverflow-track');
    const originalCards = document.querySelectorAll('.coverflow-card');
    const originalCount = originalCards.length;

    // 克隆卡片以实现无限循环（前后各克隆2组）
    const cloneCount = 2;
    const allCards = [];

    // 添加前置克隆
    for (let i = 0; i < cloneCount; i++) {
      for (let j = 0; j < originalCount; j++) {
        const clone = originalCards[j].cloneNode(true);
        clone.classList.add('clone');
        coverflowTrack.insertBefore(clone, coverflowTrack.firstChild);
        allCards.unshift(clone);
      }
    }

    // 添加原始卡片到数组
    originalCards.forEach(card => allCards.push(card));

    // 添加后置克隆
    for (let i = 0; i < cloneCount; i++) {
      for (let j = 0; j < originalCount; j++) {
        const clone = originalCards[j].cloneNode(true);
        clone.classList.add('clone');
        coverflowTrack.appendChild(clone);
        allCards.push(clone);
      }
    }

    const totalCards = allCards.length;
    let coverflowSelected = cloneCount * originalCount; // 从第一组原始卡片开始
    let isTransitioning = false;

    // 配置参数
    const CARD_WIDTH = 160;
    const ROTATE = 60;
    const DEPTH = 1.5;
    const PERSPECTIVE = 2.9;
    const FALLOFF = 1.0;
    const FADE = 0.2;

    function updateCoverflowCards() {
      allCards.forEach((card, i) => {
        const offset = i - coverflowSelected;
        const absOffset = Math.abs(offset);

        const sign = offset === 0 ? 0 : offset / absOffset;
        const distanceFactor = Math.pow(absOffset, FALLOFF);

        const rotateY = sign * ROTATE * distanceFactor;
        const translateX = sign * DEPTH * CARD_WIDTH * distanceFactor;
        const translateZ = -absOffset * 80;
        const opacity = Math.max(0, 1 - absOffset * FADE);
        const zIndex = 100 - absOffset;

        card.style.transform = `
          translateX(calc(-50% + ${translateX}px))
          translateZ(${translateZ}px)
          rotateY(${rotateY}deg)
        `;
        card.style.opacity = opacity;
        card.style.zIndex = zIndex;
      });
    }

    function coverflowNext() {
      if (isTransitioning) return;
      isTransitioning = true;

      coverflowSelected++;
      updateCoverflowCards();

      // 如果到达后置克隆区域，无缝跳回对应的原始位置
      setTimeout(() => {
        if (coverflowSelected >= (cloneCount + 1) * originalCount) {
          // 禁用过渡效果
          allCards.forEach(card => {
            card.style.transition = 'none';
          });

          coverflowSelected = cloneCount * originalCount;
          updateCoverflowCards();

          // 重新启用过渡效果
          setTimeout(() => {
            allCards.forEach(card => {
              card.style.transition = 'transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.6s ease';
            });
            isTransitioning = false;
          }, 50);
        } else {
          isTransitioning = false;
        }
      }, 600);
    }

    function coverflowPrev() {
      if (isTransitioning) return;
      isTransitioning = true;

      coverflowSelected--;
      updateCoverflowCards();

      // 如果到达前置克隆区域，无缝跳回对应的原始位置
      setTimeout(() => {
        if (coverflowSelected < cloneCount * originalCount) {
          // 禁用过渡效果
          allCards.forEach(card => {
            card.style.transition = 'none';
          });

          coverflowSelected = (cloneCount + 1) * originalCount - 1;
          updateCoverflowCards();

          // 重新启用过渡效果
          setTimeout(() => {
            allCards.forEach(card => {
              card.style.transition = 'transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.6s ease';
            });
            isTransitioning = false;
          }, 50);
        } else {
          isTransitioning = false;
        }
      }, 600);
    }

    function coverflowGoTo(index) {
      if (isTransitioning) return;
      coverflowSelected = cloneCount * originalCount + index;
      updateCoverflowCards();
    }

    // 初始化
    updateCoverflowCards();

    // 键盘导航
    const coverflowFrame = document.getElementById('coverflow-frame');
    if (coverflowFrame) {
      coverflowFrame.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          coverflowPrev();
        } else if (e.key === 'ArrowRight') {
          coverflowNext();
        }
      });

      // 拖拽支持
      let isDragging = false;
      let startX = 0;
      let hasSwitched = false; // 防止一次拖拽切换多次

      coverflowFrame.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.clientX;
        hasSwitched = false;
        coverflowFrame.style.cursor = 'grabbing';
      });

      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const currentX = e.clientX;
        const diff = currentX - startX;

        // 拖动超过 80px 且还没切换过，才切换一次
        if (Math.abs(diff) > 80 && !hasSwitched) {
          if (diff > 0) {
            coverflowPrev();
          } else {
            coverflowNext();
          }
          hasSwitched = true; // 标记已切换，防止连续切换
        }
      });

      document.addEventListener('mouseup', () => {
        isDragging = false;
        hasSwitched = false;
        if (coverflowFrame) {
          coverflowFrame.style.cursor = 'grab';
        }
      });

      // 触摸支持
      let touchStartX = 0;
      let touchSwitched = false;

      coverflowFrame.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].clientX;
        touchSwitched = false;
      });

      coverflowFrame.addEventListener('touchmove', (e) => {
        if (!touchStartX) return;
        const touchX = e.touches[0].clientX;
        const diff = touchX - touchStartX;

        // 触摸滑动超过 80px 且还没切换过，才切换一次
        if (Math.abs(diff) > 80 && !touchSwitched) {
          if (diff > 0) {
            coverflowPrev();
          } else {
            coverflowNext();
          }
          touchSwitched = true;
        }
      });

      coverflowFrame.addEventListener('touchend', () => {
        touchStartX = 0;
        touchSwitched = false;
      });
    }

    window.coverflowNext = coverflowNext;
    window.coverflowPrev = coverflowPrev;
    window.coverflowGoTo = coverflowGoTo;

    // Gallery slider functionality (已移除旧的轮播代码)
  </script>

  <!-- GSAP Animation Scripts -->
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    window.addEventListener('load', () => {
      // Initialize GSAP and ScrollTrigger
      gsap.registerPlugin(ScrollTrigger);

      console.log('GSAP animations initialized');

      // Page load animations - Header
      gsap.from('header', {
        y: -50,
        opacity: 0,
        duration: 0.8,
        ease: 'power3.out'
      });

      // Right side indicators
      gsap.set('.dot-indicator', { x: 0, opacity: 1 });
      gsap.from('.dot-indicator', {
        x: 30,
        opacity: 0,
        duration: 0.6,
        stagger: 0.08,
        ease: 'power3.out',
        delay: 0.3
      });

      gsap.set('#page-numbers', { x: 0, opacity: 1 });
      gsap.from('#page-numbers', {
        x: 30,
        opacity: 0,
        duration: 0.6,
        ease: 'power3.out',
        delay: 0.2
      });

      // Section 1: Hero entrance animation - only specific elements
      const heroTitle = document.querySelector('#section-1 h1');
      const heroDesc = document.querySelector('#section-1 p');
      const heroBtn = document.querySelector('#section-1 a');

      if (heroTitle) {
        gsap.from(heroTitle, {
          y: 60,
          opacity: 0,
          duration: 1,
          ease: 'power3.out',
          delay: 0.2
        });
      }

      if (heroDesc) {
        gsap.from(heroDesc, {
          y: 30,
          opacity: 0,
          duration: 0.8,
          ease: 'power3.out',
          delay: 0.4
        });
      }

      if (heroBtn) {
        gsap.from(heroBtn, {
          scale: 0.9,
          opacity: 0,
          duration: 0.6,
          ease: 'back.out(1.5)',
          delay: 0.6
        });
      }

      // Animate catalog cards on scroll - lighter effect
      const cards = document.querySelectorAll('.glass-card, .glass-card-active');
      if (cards.length > 0) {
        cards.forEach((card) => {
          gsap.from(card, {
            scrollTrigger: {
              trigger: card,
              start: 'top 85%',
              end: 'top 70%',
              toggleActions: 'play none none none',
            },
            y: 40,
            opacity: 0,
            duration: 0.6,
            ease: 'power2.out',
          });
        });
      }

      // Section animations disabled - causing visibility issues
      // If you want to add animations, use CSS animations instead of GSAP for these sections

      // Hover effects for interactive elements
      const appCols = document.querySelectorAll('.app-col');
      appCols.forEach(col => {
        col.addEventListener('mouseenter', () => {
          gsap.to(col, {
            scale: 1.02,
            duration: 0.3,
            ease: 'power2.out',
          });
        });

        col.addEventListener('mouseleave', () => {
          gsap.to(col, {
            scale: 1,
            duration: 0.3,
            ease: 'power2.out',
          });
        });
      });

      console.log('GSAP animations setup complete');
    });
    const accordionGroup = document.querySelector('.accordion-group');
const defaultActiveItem = document.querySelector('.accordion-item.active');

if (accordionGroup) {
  accordionGroup.addEventListener('mouseleave', () => {
    const items = document.querySelectorAll('.accordion-item');
    items.forEach(i => i.classList.remove('active'));
    if (defaultActiveItem) {
      defaultActiveItem.classList.add('active');
    }
  });

  const items = document.querySelectorAll('.accordion-item');
  items.forEach(item => {
    item.addEventListener('mouseenter', () => {
      items.forEach(i => i.classList.remove('active'));
      item.classList.add('active');
    });
  });
}
  </script>

