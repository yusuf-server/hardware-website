---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCategories } from '@/lib/woocommerce';

// 生成静态路径
export async function getStaticPaths() {
  // 这里可以从 WooCommerce 获取所有产品，暂时返回示例产品
  return [
    { params: { slug: 'turning-inserts' } },
    { params: { slug: 'milling-inserts' } },
    { params: { slug: 'drilling-inserts' } },
    { params: { slug: 'turning-holders' } },
    { params: { slug: 'grooving-holders' } },
    { params: { slug: 'threading-holders' } },
    { params: { slug: 'milling-cutters' } },
    { params: { slug: 'boring-bars' } },
    { params: { slug: 'end-mills' } },
    { params: { slug: 'drills' } },
    { params: { slug: 'wood-aluminum' } },
    { params: { slug: 'metal-saw' } },
    { params: { slug: 'band-saw' } },
    { params: { slug: 'ground-rods' } },
    { params: { slug: 'straight-hole' } },
    { params: { slug: 'spiral-hole' } },
  ];
}

let categories = [];
let useDefaultCategories = false;

try {
  categories = await getCategories();
  if (!categories || categories.length === 0) {
    useDefaultCategories = true;
  }
} catch (e) {
  console.error('Error fetching categories:', e);
  useDefaultCategories = true;
}

// 默认分类结构（如果 WooCommerce 获取失败）
const defaultCategories = [
  {
    id: 1,
    name: 'CNC Tools Series',
    slug: 'cnc-tools',
    children: [
      {
        id: 11,
        name: 'CNC Inserts',
        slug: 'cnc-inserts',
        children: [
          { id: 111, name: 'Turning Inserts', slug: 'turning-inserts' },
          { id: 112, name: 'Milling Inserts', slug: 'milling-inserts' },
          { id: 113, name: 'Drilling Inserts', slug: 'drilling-inserts' },
        ]
      },
      {
        id: 12,
        name: 'Tool Holders',
        slug: 'tool-holders',
        children: [
          { id: 121, name: 'Turning Holders', slug: 'turning-holders' },
          { id: 122, name: 'Grooving Holders', slug: 'grooving-holders' },
          { id: 123, name: 'Threading Holders', slug: 'threading-holders' },
          { id: 124, name: 'Milling Cutters', slug: 'milling-cutters' },
          { id: 125, name: 'Boring Bars', slug: 'boring-bars' },
        ]
      },
      {
        id: 13,
        name: 'Solid Carbide Tools',
        slug: 'solid-carbide',
        children: [
          { id: 131, name: 'Solid Carbide End Mills', slug: 'end-mills' },
          { id: 132, name: 'Solid Carbide Drills', slug: 'drills' },
        ]
      },
    ]
  },
  {
    id: 2,
    name: 'Carbide Products Series',
    slug: 'carbide-products',
    children: [
      {
        id: 21,
        name: 'Carbide Saw Tips',
        slug: 'saw-tips',
        children: [
          { id: 211, name: 'Wood & Aluminum Saw Tips', slug: 'wood-aluminum' },
          { id: 212, name: 'Metal Saw Tips', slug: 'metal-saw' },
          { id: 213, name: 'Band Saw Tips', slug: 'band-saw' },
        ]
      },
      {
        id: 22,
        name: 'Carbide Rods',
        slug: 'carbide-rods',
        children: [
          { id: 221, name: 'Precision Ground Rods', slug: 'ground-rods' },
          { id: 222, name: 'Straight Hole Rods', slug: 'straight-hole' },
          { id: 223, name: 'Spiral Hole Rods', slug: 'spiral-hole' },
        ]
      },
    ]
  },
];

const displayCategories = useDefaultCategories ? defaultCategories : categories;

// 获取产品 slug
const { slug } = Astro.params;
---

