<script>
  // 左侧菜单折叠/展开功能
  document.addEventListener('DOMContentLoaded', () => {
    // 一级分类点击
    const erjiLinks = document.querySelectorAll('.subnav .erji > a');
    erjiLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const parentLi = this.parentElement;
        const subUl = parentLi.querySelector(':scope > ul');

        if (subUl) {
          // 切换显示/隐藏
          if (subUl.style.display === 'block') {
            subUl.style.display = 'none';
            this.classList.remove('cur');
          } else {
            subUl.style.display = 'block';
            this.classList.add('cur');
          }
        }
      });
    });

    // 二级分类点击
    const sanjiLinks = document.querySelectorAll('.subnav .sanji > a');
    sanjiLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        const parentLi = this.parentElement;
        const subUl = parentLi.querySelector(':scope > ul');

        if (subUl) {
          e.preventDefault();
          // 切换显示/隐藏
          if (subUl.style.display === 'block') {
            subUl.style.display = 'none';
          } else {
            subUl.style.display = 'block';
          }
        }
      });
    });
  });
</script>
