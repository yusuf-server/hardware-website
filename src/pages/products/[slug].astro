---
import MainLayout from '@/layouts/MainLayout.astro';
import { getProducts, getProductBySlug, getProductCategories } from '@/lib/wordpress';

// 生成静态路径
export async function getStaticPaths() {
  try {
    const products = await getProducts(100);

    return products.map(product => ({
      params: { slug: product.slug },
      props: { product },
    }));
  } catch (error) {
    console.error('Error generating product paths:', error);
    return [];
  }
}

const { slug } = Astro.params;
const { product: initialProduct } = Astro.props;

const product = initialProduct || await getProductBySlug(slug);

if (!product) {
  return Astro.redirect('/404');
}

// 获取分类
let categories = [];
try {
  categories = await getProductCategories();
} catch (e) {
  console.error('Error fetching categories:', e);
}

const categoryTree = categories
  .filter(cat => cat.parent === 0)
  .map(parentCat => ({
    ...parentCat,
    children: categories.filter(cat => cat.parent === parentCat.id),
  }));

// 获取产品所属的分类
const productCategoryIds = product['product-categories'] || [];
const productCategories = categories.filter(cat => productCategoryIds.includes(cat.id));

// 找到主分类（如果有父分类，显示父分类 > 子分类）
let primaryCategory = productCategories[0];
let parentCategory = null;

if (primaryCategory && primaryCategory.parent !== 0) {
  parentCategory = categories.find(cat => cat.id === primaryCategory.parent);
}

const acf = product.acf || {};
const productImages = acf.product_images || [];
const specDisplayType = acf.spec_display_type || 'table';
const specificationsTable = acf.specifications_table || [];
const specificationsImage = acf.specifications_image;
const catalogLink = acf.catalog_link;

// 获取特色图片
const featuredImage = product._embedded?.['wp:featuredmedia']?.[0]?.source_url;
// 使用产品图库的第一张或特色图片
const mainImage = productImages[0]?.url || featuredImage || 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=800&q=80';
---

<MainLayout title={`${product.title.rendered} - LUMENLAB`}>

  <!-- Hero Banner -->
  <div class="nybanner relative h-[300px] md:h-[400px] overflow-hidden">
    <img
      src={mainImage}
      class="absolute inset-0 w-full h-full object-cover"
      alt={product.title.rendered}
    >
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="container max-w-7xl mx-auto px-8 md:px-16 relative z-10 h-full flex items-center">
      <div class="title">
        <h3 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white" style="font-weight: 900;">{product.title.rendered}</h3>
      </div>
    </div>
  </div>

  <!-- Breadcrumb -->
  <div class="crumb bg-gray-50 border-b border-gray-100 py-4">
    <div class="container max-w-7xl mx-auto px-8 md:px-16 flex items-center text-sm text-gray-600">
      <i data-lucide="home" class="w-4 h-4 mr-2"></i>
      <a href="/" class="hover:text-blue-400 transition-colors">Home</a>
      <span class="mx-2">></span>
      <a href="/products" class="hover:text-blue-400 transition-colors">Products</a>
      {parentCategory && (
        <>
          <span class="mx-2">></span>
          <span class="text-gray-600">{parentCategory.name}</span>
        </>
      )}
      {primaryCategory && (
        <>
          <span class="mx-2">></span>
          <span class="text-gray-600">{primaryCategory.name}</span>
        </>
      )}
      <span class="mx-2">></span>
      <span class="text-blue-400">{product.title.rendered}</span>
    </div>
  </div>

  <!-- Main Content -->
  <section class="relative py-16 px-8 md:px-16 bg-white">
    <div class="container max-w-7xl mx-auto">
      <div class="flex flex-col lg:flex-row gap-8">

        <!-- Left Sidebar -->
        <aside class="lg:w-80 flex-shrink-0">
          <div class="sticky top-24 subnav bg-gray-50 border border-gray-200 rounded-lg overflow-hidden">
            <ul>
              {categoryTree.map((category) => (
                <li class="erji">
                  <a href="javascript:;">
                    <span>{category.name}</span>
                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                  </a>
                  {category.children && category.children.length > 0 && (
                    <ul>
                      {category.children.map((subCat) => (
                        <li class="sanji">
                          <a href={`/products/${subCat.slug}`}>
                            <span>{subCat.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </aside>

        <!-- Right Main Content -->
        <main class="flex-1">

          <!-- 产品基本信息区域 -->
          <div class="product-info-section mb-12">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">

              <!-- 左侧：产品图片 -->
              <div class="product-gallery">
                {productImages.length > 1 ? (
                  <!-- 多图轮播 -->
                  <div class="swiper product-swiper rounded-2xl overflow-hidden border border-gray-200">
                    <div class="swiper-wrapper">
                      {productImages.map((img) => (
                        <div class="swiper-slide">
                          <img src={img.url} alt={img.alt || product.title.rendered} class="w-full h-auto" />
                        </div>
                      ))}
                    </div>
                    <div class="swiper-pagination"></div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                  </div>
                ) : (
                  <!-- 单图 -->
                  <div class="rounded-2xl overflow-hidden border border-gray-200">
                    <img src={mainImage} alt={product.title.rendered} class="w-full h-auto" />
                  </div>
                )}
              </div>

              <!-- 右侧：产品信息 -->
              <div class="product-details">
                <h1 class="text-3xl font-bold text-gray-900 mb-4" style="font-weight: 800;">{product.title.rendered}</h1>

                {product.excerpt.rendered && (
                  <div class="text-lg text-gray-600 mb-6" set:html={product.excerpt.rendered} />
                )}

                {catalogLink && (
                  <div class="mb-6">
                    <a
                      href={catalogLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-all font-medium"
                      style="font-weight: 600;"
                    >
                      <i data-lucide="book-open" class="w-5 h-5"></i>
                      View E-Catalog
                    </a>
                  </div>
                )}
              </div>

            </div>
          </div>

          <!-- 产品详细描述 -->
          {product.content.rendered && (
            <div class="product-description mb-12">
              <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-2 border-b-2 border-blue-500" style="font-weight: 700;">Product Description</h2>
              <div class="prose prose-lg max-w-none text-gray-700
                          prose-img:rounded-xl prose-img:shadow-lg prose-img:w-full prose-img:h-auto
                          prose-headings:text-gray-900 prose-h2:text-2xl prose-h3:text-xl
                          prose-p:leading-relaxed prose-p:mb-4
                          prose-ul:list-disc prose-ul:ml-6
                          prose-ol:list-decimal prose-ol:ml-6
                          prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline
                          prose-table:w-full prose-table:border-collapse
                          prose-th:bg-gray-100 prose-th:border prose-th:border-gray-300 prose-th:px-4 prose-th:py-2
                          prose-td:border prose-td:border-gray-300 prose-td:px-4 prose-td:py-2">
                <Fragment set:html={product.content.rendered} />
              </div>
            </div>
          )}

          <!-- 技术规格 -->
          <div class="specifications-section mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4 pb-2 border-b-2 border-blue-500" style="font-weight: 700;">Technical Specifications</h2>

            {specDisplayType === 'table' && specificationsTable.length > 0 ? (
              <!-- 表格数据方式 -->
              <div class="overflow-x-auto">
                <table class="w-full border-collapse">
                  <thead>
                    <tr class="bg-gradient-to-r from-blue-600 to-blue-700 text-white">
                      <th class="border border-blue-500 px-4 py-3 text-left font-semibold">型号</th>
                      <th class="border border-blue-500 px-4 py-3 text-left font-semibold">IC</th>
                      <th class="border border-blue-500 px-4 py-3 text-left font-semibold">d</th>
                      <th class="border border-blue-500 px-4 py-3 text-left font-semibold">l</th>
                      <th class="border border-blue-500 px-4 py-3 text-left font-semibold">s</th>
                      <th class="border border-blue-500 px-4 py-3 text-left font-semibold">r</th>
                      <th class="border border-blue-500 px-4 py-3 text-left font-semibold">牌号 Grade</th>
                    </tr>
                  </thead>
                  <tbody>
                    {specificationsTable.map((row, index) => (
                      <tr class={index % 2 === 0 ? 'bg-gray-50 hover:bg-blue-50' : 'bg-white hover:bg-blue-50'}>
                        <td class="border border-gray-300 px-4 py-3 text-gray-900 font-medium">{row.model || '-'}</td>
                        <td class="border border-gray-300 px-4 py-3 text-gray-700">{row.ic || '-'}</td>
                        <td class="border border-gray-300 px-4 py-3 text-gray-700">{row.d || '-'}</td>
                        <td class="border border-gray-300 px-4 py-3 text-gray-700">{row.l || '-'}</td>
                        <td class="border border-gray-300 px-4 py-3 text-gray-700">{row.s || '-'}</td>
                        <td class="border border-gray-300 px-4 py-3 text-gray-700">{row.r || '-'}</td>
                        <td class="border border-gray-300 px-4 py-3 text-gray-700">{row.grade || '-'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : specDisplayType === 'image' && specificationsImage ? (
              <!-- 图片方式 -->
              <div class="specifications-image rounded-xl overflow-hidden border border-gray-200">
                <img
                  src={specificationsImage.url}
                  alt={specificationsImage.alt || '技术规格'}
                  class="w-full h-auto"
                />
              </div>
            ) : (
              <p class="text-gray-500 text-center py-8">No technical specifications available</p>
            )}
          </div>

        </main>

      </div>
    </div>
  </section>

</MainLayout>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/pagination';

  document.addEventListener('DOMContentLoaded', () => {
    // 产品图片轮播
    const swiperEl = document.querySelector('.product-swiper');
    if (swiperEl) {
      new Swiper('.product-swiper', {
        modules: [Navigation, Pagination],
        loop: productImages.length > 1,
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
        },
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
      });
    }

    // 左侧菜单折叠
    const erjiLinks = document.querySelectorAll('.subnav .erji > a');
    erjiLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const parentLi = this.parentElement;
        const subUl = parentLi.querySelector(':scope > ul');

        if (subUl) {
          const isOpen = subUl.style.display === 'block';
          subUl.style.display = isOpen ? 'none' : 'block';
          this.classList.toggle('cur', !isOpen);
        }
      });
    });
  });
</script>

<style>
  .product-swiper {
    position: relative;
  }

  .swiper-button-prev,
  .swiper-button-next {
    color: #fff;
    background: rgba(0, 0, 0, 0.5);
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }

  .swiper-button-prev:after,
  .swiper-button-next:after {
    font-size: 22px;
  }

  .swiper-pagination-bullet {
    background: #fff;
    opacity: 0.7;
  }

  .swiper-pagination-bullet-active {
    background: #3b82f6;
    opacity: 1;
  }
</style>
