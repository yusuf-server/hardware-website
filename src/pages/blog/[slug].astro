---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPosts, getPostBySlug } from '@/lib/wordpress';

export async function getStaticPaths() {
  try {
    const posts = await getPosts(100);
    return posts.map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
  } catch (error) {
    console.error('Error fetching posts for static paths:', error);
    return [];
  }
}

const { slug } = Astro.params;
const { post } = Astro.props;

if (!post) {
  return Astro.redirect('/404');
}

const featuredImage = post._embedded?.['wp:featuredmedia']?.[0]?.source_url;
---

<BaseLayout title={post.title.rendered + ' - 五金网站'}>
  <article class="post">
    {featuredImage && (
      <img src={featuredImage} alt={post.title.rendered} class="featured-image" />
    )}

    <h1 set:html={post.title.rendered} />

    <div class="meta">
      <time datetime={post.date}>
        {new Date(post.date).toLocaleDateString('zh-CN', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        })}
      </time>
    </div>

    <div class="content" set:html={post.content.rendered} />

    <div class="back-link">
      <a href="/blog">← 返回博客列表</a>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    max-width: 800px;
    margin: 0 auto;
  }

  .featured-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 2.5rem;
    color: #1f2937;
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .meta {
    color: #6b7280;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .content {
    font-size: 1.125rem;
    line-height: 1.75;
    color: #374151;
  }

  .content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }

  .content :global(a) {
    color: #3b82f6;
    text-decoration: underline;
  }

  .content :global(pre) {
    background: #1f2937;
    color: #f9fafb;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
  }

  .content :global(code) {
    background: #f3f4f6;
    padding: 0.125rem 0.25rem;
    border-radius: 2px;
    font-size: 0.875em;
  }

  .content :global(pre code) {
    background: transparent;
    padding: 0;
  }

  .back-link {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #e5e7eb;
  }

  .back-link a {
    color: #3b82f6;
    text-decoration: none;
    font-weight: 500;
  }

  .back-link a:hover {
    color: #2563eb;
  }
</style>
