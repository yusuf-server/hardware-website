---
import MainLayout from '@/layouts/MainLayout.astro';
import { getProducts, getProductCategories } from '@/lib/wordpress';

// 获取产品分类
let categories = [];
try {
  categories = await getProductCategories();
} catch (e) {
  console.error('Error fetching categories:', e);
}

// 构建分类树结构（支持三级分类）
const buildCategoryTree = (cats: any[]) => {
  const categoryMap = new Map();

  // 第一遍：创建所有分类的映射
  cats.forEach(cat => {
    categoryMap.set(cat.id, { ...cat, children: [] });
  });

  // 第二遍：构建父子关系
  const roots: any[] = [];
  cats.forEach(cat => {
    const category = categoryMap.get(cat.id);
    if (cat.parent === 0) {
      roots.push(category);
    } else {
      const parent = categoryMap.get(cat.parent);
      if (parent) {
        parent.children.push(category);
      }
    }
  });

  return roots;
};

const categoryTree = buildCategoryTree(categories);

// 获取产品列表
let products = [];
try {
  products = await getProducts(50); // 获取前50个产品
} catch (e) {
  console.error('Error fetching products:', e);
}
---

<MainLayout title="Products - LUMENLAB">

  <!-- Hero Banner -->
  <div class="nybanner relative h-[300px] md:h-[400px] overflow-hidden">
    <img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=2000&q=80" class="absolute inset-0 w-full h-full object-cover" alt="Products">
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="container max-w-7xl mx-auto px-8 md:px-16 relative z-10 h-full flex items-center">
      <div class="title">
        <h3 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white" style="font-weight: 900;">Product Center</h3>
      </div>
    </div>
  </div>

  <!-- Breadcrumb -->
  <div class="crumb bg-gray-50 border-b border-gray-100 py-4">
    <div class="container max-w-7xl mx-auto px-8 md:px-16 flex items-center text-sm text-gray-600">
      <i data-lucide="home" class="w-4 h-4 mr-2"></i>
      <a href="/" class="hover:text-blue-400 transition-colors">Home</a>
      <span class="mx-2">></span>
      <a href="/products" class="text-blue-400">Product Center</a>
    </div>
  </div>

  <!-- Main Content -->
  <section class="relative py-16 px-8 md:px-16 bg-white">
    <div class="container max-w-7xl mx-auto">
      <div class="flex flex-col lg:flex-row gap-8">

        <!-- Left Sidebar -->
        <aside class="lg:w-80 flex-shrink-0">
          <div class="sticky top-24 subnav bg-gray-50 border border-gray-200 rounded-lg overflow-hidden">
            <ul>
              {categoryTree.map((category, catIndex) => (
                <li class="erji">
                  <a href="javascript:;" data-category-id={category.id}>
                    <span>{category.name}</span>
                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                  </a>
                  {category.children && category.children.length > 0 && (
                    <ul>
                      {category.children.map((subCat, subIndex) => (
                        <li class="sanji">
                          <a
                            href={subCat.children && subCat.children.length > 0 ? 'javascript:;' : `/products/${subCat.slug}`}
                            data-category-id={subCat.id}
                          >
                            <span>{subCat.name}</span>
                            {subCat.children && subCat.children.length > 0 && (
                              <i data-lucide="chevron-up" class="w-3 h-3"></i>
                            )}
                          </a>
                          {subCat.children && subCat.children.length > 0 && (
                            <ul>
                              {subCat.children.map((subSubCat, subSubIndex) => (
                                <li class="siji">
                                  <a
                                    href={`/products/${subSubCat.slug}`}
                                    data-category-id={subSubCat.id}
                                  >
                                    {subSubCat.name}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </aside>

        <!-- Right Main Content -->
        <main class="flex-1">

          <!-- Search Filter Form -->
          <div class="search-form bg-gradient-to-br from-white/5 to-white/2 border border-gray-200 rounded-2xl p-6 mb-8 backdrop-blur-sm">
            <form class="flex flex-col md:flex-row gap-4">

              <select class="flex-1 px-4 py-3 rounded-lg bg-gray-50 border border-gray-200 text-gray-700 focus:border-blue-500 focus:outline-none transition-all" style="font-weight: 400;">
                <option value="">Select Main Category</option>
                <option value="turning">Turning Tools</option>
                <option value="milling">Milling Tools</option>
                <option value="drilling">Drilling Tools</option>
              </select>

              <select class="flex-1 px-4 py-3 rounded-lg bg-gray-50 border border-gray-200 text-gray-700 focus:border-blue-500 focus:outline-none transition-all" style="font-weight: 400;">
                <option value="">Select Sub Category</option>
                <option value="iso">ISO Inserts</option>
                <option value="thread">Threading</option>
                <option value="groove">Grooving</option>
              </select>

              <select class="flex-1 px-4 py-3 rounded-lg bg-gray-50 border border-gray-200 text-gray-700 focus:border-blue-500 focus:outline-none transition-all" style="font-weight: 400;">
                <option value="">Select Type</option>
                <option value="positive">Positive Rake</option>
                <option value="negative">Negative Rake</option>
              </select>

              <input type="text" placeholder="Enter keyword..." class="flex-1 px-4 py-3 rounded-lg bg-gray-50 border border-gray-200 text-gray-700 placeholder-gray-500 focus:border-blue-500 focus:outline-none transition-all" style="font-weight: 400;">

              <button type="submit" class="px-8 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-gray-900 font-medium transition-all flex items-center gap-2 whitespace-nowrap" style="font-weight: 600;">
                <i data-lucide="search" class="w-4 h-4"></i>
                <span>Search</span>
              </button>

            </form>
          </div>

          <!-- Product Grid -->
          <div class="product-grid">
            <ul id="productList" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

              {products.map((product) => {
                const featuredImage = product._embedded?.['wp:featuredmedia']?.[0]?.source_url || 'https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=800&q=80';
                const productImage = product.acf?.product_images?.[0]?.url || featuredImage;
                // 获取产品的分类 ID 列表
                const productCategories = product['product-categories'] || [];

                return (
                  <li class="group product-item" data-categories={JSON.stringify(productCategories)}>
                    <div class="relative bg-gradient-to-br from-white/5 to-white/2 border border-gray-200 rounded-2xl overflow-hidden hover:border-blue-500/40 transition-all duration-300 backdrop-blur-sm">
                      <a href={`/products/${product.slug}`} class="block">
                        <div class="pic aspect-square overflow-hidden bg-gradient-to-br from-blue-900/10 to-purple-900/10">
                          <img
                            src={productImage}
                            alt={product.title.rendered}
                            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                          />
                        </div>
                        <div class="info p-6">
                          <h4 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors line-clamp-2" style="font-weight: 700;">
                            {product.title.rendered}
                          </h4>
                          {product.excerpt.rendered && (
                            <div class="text-sm text-gray-600 line-clamp-2" set:html={product.excerpt.rendered} />
                          )}
                        </div>
                      </a>
                    </div>
                  </li>
                );
              })}

              {products.length === 0 && (
                <li class="col-span-full text-center py-12">
                  <p class="text-gray-500 text-lg">No products found</p>
                  <p class="text-gray-400 text-sm mt-2">Please add products in WordPress admin</p>
                </li>
              )}

            </ul>

            <!-- 无筛选结果提示 -->
            <div id="noResults" class="hidden text-center py-12">
              <p class="text-gray-500 text-lg">No products found in this category</p>
              <p class="text-gray-400 text-sm mt-2">Try selecting a different category</p>
            </div>
          </div>

        </main>

      </div>
    </div>
  </section>

</MainLayout>

<script>
  // 左侧菜单折叠/展开功能和产品筛选
  document.addEventListener('DOMContentLoaded', () => {
    const productItems = document.querySelectorAll('.product-item');
    const productList = document.getElementById('productList');
    const noResults = document.getElementById('noResults');

    // 更新面包屑
    function updateBreadcrumb(parentName = '', currentName = '') {
      const breadcrumb = document.querySelector('.crumb .container');
      if (!breadcrumb) return;

      let breadcrumbHTML = `
        <i data-lucide="home" class="w-4 h-4 mr-2"></i>
        <a href="/" class="hover:text-blue-400 transition-colors">Home</a>
        <span class="mx-2">></span>
      `;

      if (!parentName && !currentName) {
        breadcrumbHTML += `<span class="text-blue-400">Product Center</span>`;
      } else {
        breadcrumbHTML += `<a href="/products" class="hover:text-blue-400 transition-colors">Product Center</a>`;

        if (parentName) {
          breadcrumbHTML += `
            <span class="mx-2">></span>
            <span class="text-gray-600">${parentName}</span>
          `;
        }

        if (currentName) {
          breadcrumbHTML += `
            <span class="mx-2">></span>
            <span class="text-blue-400">${currentName}</span>
          `;
        }
      }

      breadcrumb.innerHTML = breadcrumbHTML;

      // 重新初始化图标
      if (window.lucide) {
        window.lucide.createIcons();
      }
    }

    // 产品筛选函数
    function filterProducts(categoryId, parentName = '', currentName = '') {
      console.log('Filtering by category ID:', categoryId);
      let visibleCount = 0;

      productItems.forEach(item => {
        const categoriesStr = item.getAttribute('data-categories');
        console.log('Product categories string:', categoriesStr);
        const categories = JSON.parse(categoriesStr || '[]');
        console.log('Product categories array:', categories);

        if (!categoryId || categories.includes(categoryId)) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      console.log('Visible products:', visibleCount);

      // 显示/隐藏无结果提示
      if (visibleCount === 0) {
        productList.style.display = 'none';
        noResults.classList.remove('hidden');
      } else {
        productList.style.display = 'grid';
        noResults.classList.add('hidden');
      }

      // 更新面包屑
      updateBreadcrumb(parentName, currentName);
    }

    // 一级分类点击
    const erjiLinks = document.querySelectorAll('.subnav .erji > a');
    erjiLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const parentLi = this.parentElement;
        const subUl = parentLi.querySelector(':scope > ul');

        if (subUl) {
          // 切换显示/隐藏
          if (subUl.style.display === 'block') {
            subUl.style.display = 'none';
            this.classList.remove('cur');
          } else {
            subUl.style.display = 'block';
            this.classList.add('cur');
          }
        }

        // 获取一级分类 ID
        const categoryId = parseInt(this.getAttribute('data-category-id'));
        const categoryName = this.querySelector('span')?.textContent || '';

        // 如果一级分类有 ID，也进行筛选；否则显示所有
        if (categoryId) {
          // 收集该分类及其所有子分类的 ID
          const allCategoryIds = [categoryId];
          const subCategories = parentLi.querySelectorAll('.sanji > a[data-category-id]');
          subCategories.forEach(subLink => {
            const subId = parseInt(subLink.getAttribute('data-category-id'));
            if (subId) allCategoryIds.push(subId);
          });

          // 筛选：显示属于该分类或其子分类的产品
          let visibleCount = 0;
          productItems.forEach(item => {
            const categoriesStr = item.getAttribute('data-categories');
            const categories = JSON.parse(categoriesStr || '[]');

            // 检查产品是否属于该分类树
            const hasMatch = categories.some(catId => allCategoryIds.includes(catId));

            if (hasMatch) {
              item.style.display = 'block';
              visibleCount++;
            } else {
              item.style.display = 'none';
            }
          });

          if (visibleCount === 0) {
            productList.style.display = 'none';
            noResults.classList.remove('hidden');
          } else {
            productList.style.display = 'grid';
            noResults.classList.add('hidden');
          }

          updateBreadcrumb('', categoryName);
        } else {
          filterProducts(null, '', categoryName);
        }

        // 移除其他分类的选中状态
        document.querySelectorAll('.subnav a').forEach(a => a.classList.remove('cur'));
        this.classList.add('cur');
      });
    });

    // 二级/三级分类点击
    const sanjiLinks = document.querySelectorAll('.subnav .sanji > a, .subnav .siji > a');
    sanjiLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        const parentLi = this.parentElement;
        const subUl = parentLi.querySelector(':scope > ul');

        // 如果有子菜单，切换显示
        if (subUl) {
          e.preventDefault();
          if (subUl.style.display === 'block') {
            subUl.style.display = 'none';
          } else {
            subUl.style.display = 'block';
          }
        } else {
          // 没有子菜单，进行筛选
          e.preventDefault();

          const categoryId = parseInt(this.getAttribute('data-category-id'));
          const categoryName = this.querySelector('span')?.textContent || '';

          // 获取父分类名称
          const parentErji = this.closest('.erji');
          const parentLink = parentErji?.querySelector(':scope > a');
          const parentName = parentLink?.querySelector('span')?.textContent || '';

          if (categoryId) {
            filterProducts(categoryId, parentName, categoryName);

            // 更新选中状态
            document.querySelectorAll('.subnav a').forEach(a => a.classList.remove('cur'));
            this.classList.add('cur');
          }
        }
      });
    });
  });
</script>
