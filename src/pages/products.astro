---
import MainLayout from '@/layouts/MainLayout.astro';
import { getCategories } from '@/lib/woocommerce';

let categories = [];
let useDefaultCategories = false;

try {
  categories = await getCategories();
  if (!categories || categories.length === 0) {
    useDefaultCategories = true;
  }
} catch (e) {
  console.error('Error fetching categories:', e);
  useDefaultCategories = true;
}

// 默认分类结构（如果 WooCommerce 获取失败）
const defaultCategories = [
  {
    id: 1,
    name: 'CNC Tools Series',
    slug: 'cnc-tools',
    children: [
      {
        id: 11,
        name: 'CNC Inserts',
        slug: 'cnc-inserts',
        children: [
          { id: 111, name: 'Turning Inserts', slug: 'turning-inserts' },
          { id: 112, name: 'Milling Inserts', slug: 'milling-inserts' },
          { id: 113, name: 'Drilling Inserts', slug: 'drilling-inserts' },
        ]
      },
      {
        id: 12,
        name: 'Tool Holders',
        slug: 'tool-holders',
        children: [
          { id: 121, name: 'Turning Holders', slug: 'turning-holders' },
          { id: 122, name: 'Grooving Holders', slug: 'grooving-holders' },
          { id: 123, name: 'Threading Holders', slug: 'threading-holders' },
          { id: 124, name: 'Milling Cutters', slug: 'milling-cutters' },
          { id: 125, name: 'Boring Bars', slug: 'boring-bars' },
        ]
      },
      {
        id: 13,
        name: 'Solid Carbide Tools',
        slug: 'solid-carbide',
        children: [
          { id: 131, name: 'Solid Carbide End Mills', slug: 'end-mills' },
          { id: 132, name: 'Solid Carbide Drills', slug: 'drills' },
        ]
      },
    ]
  },
  {
    id: 2,
    name: 'Carbide Products Series',
    slug: 'carbide-products',
    children: [
      {
        id: 21,
        name: 'Carbide Saw Tips',
        slug: 'saw-tips',
        children: [
          { id: 211, name: 'Wood & Aluminum Saw Tips', slug: 'wood-aluminum' },
          { id: 212, name: 'Metal Saw Tips', slug: 'metal-saw' },
          { id: 213, name: 'Band Saw Tips', slug: 'band-saw' },
        ]
      },
      {
        id: 22,
        name: 'Carbide Rods',
        slug: 'carbide-rods',
        children: [
          { id: 221, name: 'Precision Ground Rods', slug: 'ground-rods' },
          { id: 222, name: 'Straight Hole Rods', slug: 'straight-hole' },
          { id: 223, name: 'Spiral Hole Rods', slug: 'spiral-hole' },
        ]
      },
    ]
  },
];

const displayCategories = useDefaultCategories ? defaultCategories : categories;
---

<MainLayout title="Products - LUMENLAB">

  <!-- Hero Banner -->
  <div class="nybanner relative h-[300px] md:h-[400px] overflow-hidden">
    <img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=2000&q=80" class="absolute inset-0 w-full h-full object-cover" alt="Products">
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="container max-w-7xl mx-auto px-8 md:px-16 relative z-10 h-full flex items-center">
      <div class="title">
        <h3 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white" style="font-weight: 900;">Product Center</h3>
      </div>
    </div>
  </div>

  <!-- Breadcrumb -->
  <div class="crumb bg-[#0a0d14] border-b border-white/5 py-4">
    <div class="container max-w-7xl mx-auto px-8 md:px-16 flex items-center text-sm text-gray-400">
      <i data-lucide="home" class="w-4 h-4 mr-2"></i>
      <a href="/" class="hover:text-blue-400 transition-colors">Home</a>
      <span class="mx-2">></span>
      <a href="/products" class="text-blue-400">Product Center</a>
    </div>
  </div>

  <!-- Main Content -->
  <section class="relative py-16 px-8 md:px-16 bg-[#06080d]">
    <div class="container max-w-7xl mx-auto">
      <div class="flex flex-col lg:flex-row gap-8">

        <!-- Left Sidebar -->
        <aside class="lg:w-80 flex-shrink-0">
          <div class="sticky top-24 subnav bg-white/5 rounded-lg overflow-hidden">
            <ul>
              {displayCategories.map((category, catIndex) => (
                <li class="erji">
                  <a href="javascript:;" class={catIndex === 0 ? 'cur' : ''}>
                    <span>{category.name}</span>
                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                  </a>
                  {category.children && category.children.length > 0 && (
                    <ul style={catIndex === 0 ? 'display: block;' : ''}>
                      {category.children.map((subCat, subIndex) => (
                        <li class="sanji">
                          <a href={subCat.children && subCat.children.length > 0 ? 'javascript:;' : `/products/${subCat.slug}`} class={catIndex === 0 && subIndex === 0 ? 'cur' : ''}>
                            <span>{subCat.name}</span>
                            {subCat.children && subCat.children.length > 0 && (
                              <i data-lucide="chevron-up" class="w-3 h-3"></i>
                            )}
                          </a>
                          {subCat.children && subCat.children.length > 0 && (
                            <ul style={catIndex === 0 && subIndex === 0 ? 'display: block;' : ''}>
                              {subCat.children.map((subSubCat, subSubIndex) => (
                                <li class="siji">
                                  <a href={`/products/${subSubCat.slug}`} class={catIndex === 0 && subIndex === 0 && subSubIndex === 0 ? 'cur' : ''}>
                                    {subSubCat.name}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </aside>

        <!-- Right Main Content -->
        <main class="flex-1">

          <!-- Search Filter Form -->
          <div class="search-form bg-gradient-to-br from-white/5 to-white/2 border border-white/10 rounded-2xl p-6 mb-8 backdrop-blur-sm">
            <form class="flex flex-col md:flex-row gap-4">

              <select class="flex-1 px-4 py-3 rounded-lg bg-[#0a0d14] border border-white/10 text-gray-300 focus:border-blue-500 focus:outline-none transition-all" style="font-weight: 400;">
                <option value="">Select Main Category</option>
                <option value="turning">Turning Tools</option>
                <option value="milling">Milling Tools</option>
                <option value="drilling">Drilling Tools</option>
              </select>

              <select class="flex-1 px-4 py-3 rounded-lg bg-[#0a0d14] border border-white/10 text-gray-300 focus:border-blue-500 focus:outline-none transition-all" style="font-weight: 400;">
                <option value="">Select Sub Category</option>
                <option value="iso">ISO Inserts</option>
                <option value="thread">Threading</option>
                <option value="groove">Grooving</option>
              </select>

              <select class="flex-1 px-4 py-3 rounded-lg bg-[#0a0d14] border border-white/10 text-gray-300 focus:border-blue-500 focus:outline-none transition-all" style="font-weight: 400;">
                <option value="">Select Type</option>
                <option value="positive">Positive Rake</option>
                <option value="negative">Negative Rake</option>
              </select>

              <input type="text" placeholder="Enter keyword..." class="flex-1 px-4 py-3 rounded-lg bg-[#0a0d14] border border-white/10 text-gray-300 placeholder-gray-500 focus:border-blue-500 focus:outline-none transition-all" style="font-weight: 400;">

              <button type="submit" class="px-8 py-3 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium transition-all flex items-center gap-2 whitespace-nowrap" style="font-weight: 600;">
                <i data-lucide="search" class="w-4 h-4"></i>
                <span>Search</span>
              </button>

            </form>
          </div>

          <!-- Product Grid -->
          <div class="product-grid">
            <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">

              <!-- Product Card 1 -->
              <li class="group">
                <div class="relative bg-gradient-to-br from-white/5 to-white/2 border border-white/10 rounded-2xl overflow-hidden hover:border-blue-500/40 transition-all duration-300 backdrop-blur-sm">
                  <a href="/products/turning-inserts" class="block">
                    <div class="pic aspect-square overflow-hidden bg-gradient-to-br from-blue-900/10 to-purple-900/10">
                      <img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?auto=format&fit=crop&w=600&q=80" alt="ISO Turning Inserts" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                    </div>
                    <div class="tt p-6">
                      <h4 class="text-lg font-bold text-white mb-2" style="font-weight: 700;">ISO Turning Inserts</h4>
                      <p class="text-sm text-gray-400" style="font-weight: 400;">High precision inserts for turning operations</p>
                    </div>
                  </a>
                  <div class="menu p-4 pt-0 flex flex-wrap gap-2">
                    <a href="/products/turning-inserts" class="px-3 py-1.5 text-xs rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-300 hover:bg-blue-600/30 transition-all" style="font-weight: 500;">Positive Rake</a>
                    <a href="/products/turning-inserts" class="px-3 py-1.5 text-xs rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-300 hover:bg-blue-600/30 transition-all" style="font-weight: 500;">Negative Rake</a>
                  </div>
                </div>
              </li>

              <!-- Product Card 2 -->
              <li class="group">
                <div class="relative bg-gradient-to-br from-white/5 to-white/2 border border-white/10 rounded-2xl overflow-hidden hover:border-blue-500/40 transition-all duration-300 backdrop-blur-sm">
                  <a href="/products/milling-inserts" class="block">
                    <div class="pic aspect-square overflow-hidden bg-gradient-to-br from-blue-900/10 to-purple-900/10">
                      <img src="https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=600&q=80" alt="Threading Inserts" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                    </div>
                    <div class="tt p-6">
                      <h4 class="text-lg font-bold text-white mb-2" style="font-weight: 700;">Milling Inserts</h4>
                      <p class="text-sm text-gray-400" style="font-weight: 400;">Precision milling solutions</p>
                    </div>
                  </a>
                  <div class="menu p-4 pt-0 flex flex-wrap gap-2">
                    <a href="/products/milling-inserts" class="px-3 py-1.5 text-xs rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-300 hover:bg-blue-600/30 transition-all" style="font-weight: 500;">Face Mill</a>
                    <a href="/products/milling-inserts" class="px-3 py-1.5 text-xs rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-300 hover:bg-blue-600/30 transition-all" style="font-weight: 500;">End Mill</a>
                  </div>
                </div>
              </li>

              <!-- Product Card 3 -->
              <li class="group">
                <div class="relative bg-gradient-to-br from-white/5 to-white/2 border border-white/10 rounded-2xl overflow-hidden hover:border-blue-500/40 transition-all duration-300 backdrop-blur-sm">
                  <a href="/products/drilling-inserts" class="block">
                    <div class="pic aspect-square overflow-hidden bg-gradient-to-br from-blue-900/10 to-purple-900/10">
                      <img src="https://images.unsplash.com/photo-1565688534245-05d6b5be184a?auto=format&fit=crop&w=600&q=80" alt="Grooving Inserts" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                    </div>
                    <div class="tt p-6">
                      <h4 class="text-lg font-bold text-white mb-2" style="font-weight: 700;">Drilling Inserts</h4>
                      <p class="text-sm text-gray-400" style="font-weight: 400;">Specialized drilling and boring tools</p>
                    </div>
                  </a>
                  <div class="menu p-4 pt-0 flex flex-wrap gap-2">
                    <a href="/products/drilling-inserts" class="px-3 py-1.5 text-xs rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-300 hover:bg-blue-600/30 transition-all" style="font-weight: 500;">Indexable</a>
                    <a href="/products/drilling-inserts" class="px-3 py-1.5 text-xs rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-300 hover:bg-blue-600/30 transition-all" style="font-weight: 500;">Solid Carbide</a>
                  </div>
                </div>
              </li>

              <!-- Product Card 4 -->
              <li class="group">
                <div class="relative bg-gradient-to-br from-white/5 to-white/2 border border-white/10 rounded-2xl overflow-hidden hover:border-blue-500/40 transition-all duration-300 backdrop-blur-sm">
                  <a href="/products/milling-cutters" class="block">
                    <div class="pic aspect-square overflow-hidden bg-gradient-to-br from-blue-900/10 to-purple-900/10">
                      <img src="https://images.unsplash.com/photo-1530124566582-a618bc2615dc?auto=format&fit=crop&w=600&q=80" alt="Milling Cutters" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                    </div>
                    <div class="tt p-6">
                      <h4 class="text-lg font-bold text-white mb-2" style="font-weight: 700;">Milling Cutters</h4>
                      <p class="text-sm text-gray-400" style="font-weight: 400;">High performance milling solutions</p>
                    </div>
                  </a>
                  <div class="menu p-4 pt-0 flex flex-wrap gap-2">
                    <a href="/products/milling-cutters" class="px-3 py-1.5 text-xs rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-300 hover:bg-blue-600/30 transition-all" style="font-weight: 500;">Face Mill</a>
                    <a href="/products/milling-cutters" class="px-3 py-1.5 text-xs rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-300 hover:bg-blue-600/30 transition-all" style="font-weight: 500;">End Mill</a>
                  </div>
                </div>
              </li>

              <!-- Product Card 5 -->
              <li class="group">
                <div class="relative bg-gradient-to-br from-white/5 to-white/2 border border-white/10 rounded-2xl overflow-hidden hover:border-blue-500/40 transition-all duration-300 backdrop-blur-sm">
                  <a href="/products/end-mills" class="block">
                    <div class="pic aspect-square overflow-hidden bg-gradient-to-br from-blue-900/10 to-purple-900/10">
                      <img src="https://images.unsplash.com/photo-1504917595217-d4dc5ebe6122?auto=format&fit=crop&w=600&q=80" alt="Drilling Tools" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                    </div>
                    <div class="tt p-6">
                      <h4 class="text-lg font-bold text-white mb-2" style="font-weight: 700;">Solid Carbide End Mills</h4>
                      <p class="text-sm text-gray-400" style="font-weight: 400;">Precision end milling tools</p>
                    </div>
                  </a>
                  <div class="menu p-4 pt-0 flex flex-wrap gap-2">
                    <a href="/products/end-mills" class="px-3 py-1.5 text-xs rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-300 hover:bg-blue-600/30 transition-all" style="font-weight: 500;">Square End</a>
                    <a href="/products/end-mills" class="px-3 py-1.5 text-xs rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-300 hover:bg-blue-600/30 transition-all" style="font-weight: 500;">Ball Nose</a>
                  </div>
                </div>
              </li>

              <!-- Product Card 6 -->
              <li class="group">
                <div class="relative bg-gradient-to-br from-white/5 to-white/2 border border-white/10 rounded-2xl overflow-hidden hover:border-blue-500/40 transition-all duration-300 backdrop-blur-sm">
                  <a href="/products/turning-holders" class="block">
                    <div class="pic aspect-square overflow-hidden bg-gradient-to-br from-blue-900/10 to-purple-900/10">
                      <img src="https://images.unsplash.com/photo-1587293852726-70cdb56c2866?auto=format&fit=crop&w=600&q=80" alt="Tool Holders" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                    </div>
                    <div class="tt p-6">
                      <h4 class="text-lg font-bold text-white mb-2" style="font-weight: 700;">Tool Holders</h4>
                      <p class="text-sm text-gray-400" style="font-weight: 400;">High rigidity tool holding systems</p>
                    </div>
                  </a>
                  <div class="menu p-4 pt-0 flex flex-wrap gap-2">
                    <a href="/products/turning-holders" class="px-3 py-1.5 text-xs rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-300 hover:bg-blue-600/30 transition-all" style="font-weight: 500;">ISO</a>
                    <a href="/products/turning-holders" class="px-3 py-1.5 text-xs rounded-full bg-blue-600/20 border border-blue-500/30 text-blue-300 hover:bg-blue-600/30 transition-all" style="font-weight: 500;">Modular</a>
                  </div>
                </div>
              </li>

            </ul>
          </div>

          <!-- Pagination -->
          <div class="pages mt-12 flex justify-center">
            <ul class="flex items-center gap-2">
              <li>
                <button class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 hover:border-blue-500/40 hover:bg-blue-600/10 text-gray-400 hover:text-white transition-all flex items-center justify-center">
                  <i data-lucide="chevron-left" class="w-4 h-4"></i>
                </button>
              </li>
              <li>
                <button class="w-10 h-10 rounded-lg bg-blue-600 border border-blue-500 text-white font-medium transition-all" style="font-weight: 600;">1</button>
              </li>
              <li>
                <button class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 hover:border-blue-500/40 hover:bg-blue-600/10 text-gray-400 hover:text-white transition-all" style="font-weight: 500;">2</button>
              </li>
              <li>
                <button class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 hover:border-blue-500/40 hover:bg-blue-600/10 text-gray-400 hover:text-white transition-all" style="font-weight: 500;">3</button>
              </li>
              <li>
                <button class="w-10 h-10 rounded-lg bg-white/5 border border-white/10 hover:border-blue-500/40 hover:bg-blue-600/10 text-gray-400 hover:text-white transition-all flex items-center justify-center">
                  <i data-lucide="chevron-right" class="w-4 h-4"></i>
                </button>
              </li>
            </ul>
          </div>

        </main>

      </div>
    </div>
  </section>

</MainLayout>

<script>
  // 左侧菜单折叠/展开功能
  document.addEventListener('DOMContentLoaded', () => {
    // 一级分类点击
    const erjiLinks = document.querySelectorAll('.subnav .erji > a');
    erjiLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const parentLi = this.parentElement;
        const subUl = parentLi.querySelector(':scope > ul');

        if (subUl) {
          // 切换显示/隐藏
          if (subUl.style.display === 'block') {
            subUl.style.display = 'none';
            this.classList.remove('cur');
          } else {
            subUl.style.display = 'block';
            this.classList.add('cur');
          }
        }
      });
    });

    // 二级分类点击
    const sanjiLinks = document.querySelectorAll('.subnav .sanji > a');
    sanjiLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        const parentLi = this.parentElement;
        const subUl = parentLi.querySelector(':scope > ul');

        if (subUl) {
          e.preventDefault();
          // 切换显示/隐藏
          if (subUl.style.display === 'block') {
            subUl.style.display = 'none';
          } else {
            subUl.style.display = 'block';
          }
        }
      });
    });
  });
</script>
