---
import MainLayout from '@/layouts/MainLayout.astro';
---

<MainLayout title="About Us - LUMENLAB">

  <!-- Hero Banner -->
  <div class="nybanner relative h-[400px] md:h-[500px] overflow-hidden">
    <img src="https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?auto=format&fit=crop&w=2000&q=80" class="absolute inset-0 w-full h-full object-cover" alt="About Us">
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="container max-w-7xl mx-auto px-8 md:px-16 relative z-10 h-full flex items-center">
      <div class="title">
        <h3 class="text-5xl md:text-6xl lg:text-7xl font-extrabold text-white" style="font-weight: 900;">About Us</h3>
      </div>
    </div>
  </div>

  <!-- Breadcrumb -->
  <div class="crumb bg-[#0a0d14] border-b border-white/5 py-4">
    <div class="container max-w-7xl mx-auto px-8 md:px-16 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div class="left flex items-center text-sm text-gray-400">
        <i data-lucide="home" class="w-4 h-4 mr-2"></i>
        <a href="/" class="hover:text-blue-400 transition-colors">Home</a>
        <span class="mx-2">></span>
        <a href="/about" class="text-blue-400">About Us</a>
      </div>
      <div class="right">
        <ul class="flex items-center gap-6 text-sm">
          <li>
            <a href="#main1" class="text-blue-400 hover:text-blue-300 transition-colors border-b-2 border-blue-400 pb-1" style="font-weight: 500;">Company Profile</a>
          </li>
          <li>
            <a href="#main2" class="text-gray-400 hover:text-blue-400 transition-colors" style="font-weight: 500;">Corporate Culture</a>
          </li>
          <li>
            <a href="#main3" class="text-gray-400 hover:text-blue-400 transition-colors" style="font-weight: 500;">Development History</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Main 1: Company Profile -->
  <section class="main1 relative py-20 md:py-32 px-8 md:px-16 overflow-hidden bg-[#06080d]" id="main1">
    <div class="absolute inset-0 bg-cover bg-center opacity-10 mix-blend-luminosity" style="background-image: url('https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?auto=format&fit=crop&w=1800&q=80');"></div>
    <div class="absolute -left-32 top-1/4 w-[600px] h-[600px] bg-blue-900/15 rounded-full filter blur-[150px] pointer-events-none"></div>
    <div class="absolute -right-32 bottom-1/4 w-[600px] h-[600px] bg-blue-600/10 rounded-full filter blur-[150px] pointer-events-none"></div>

    <div class="container max-w-7xl mx-auto relative z-10">
      <div class="flex flex-col lg:flex-row justify-between gap-12 lg:gap-16 items-start">

        <!-- Left: Content -->
        <div class="left flex-1 max-w-3xl">
          <div class="title mb-10">
            <h3 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-white mb-3" style="font-weight: 900;">Company Profile</h3>
            <span class="text-sm text-blue-400 uppercase tracking-widest" style="font-weight: 600;">Company Introduction</span>
          </div>

          <div class="con space-y-6 text-gray-300 text-base md:text-lg leading-relaxed" style="font-weight: 400;">
            <p>Founded in 1996, our company is a high-tech enterprise specializing in the research, development, production and sales of carbide products and CNC cutting tools. We successfully listed on the Science and Technology Innovation Board of the Shanghai Stock Exchange on December 10, 2020, becoming the first listed company focused on carbide cutting tools.</p>

            <p>Our carbide saw blade products rank among the top in China and have been awarded the title of "National Manufacturing Champion Product". Our CNC inserts production scale ranks in the top three in China. Through years of technical exploration, we have mastered the complete industrial chain technology from carbide manufacturing to CNC tool production.</p>

            <p>The company has established a complete R&D system with independent intellectual property rights, possessing multiple patents and proprietary technologies. We are committed to providing global customers with high-quality cutting tool solutions and continuously driving innovation in precision manufacturing.</p>
          </div>
        </div>

        <!-- Right: Stats -->
        <div class="right flex-shrink-0 w-full lg:w-auto">
          <ul class="space-y-6">
            <li class="flex items-center gap-6 bg-gradient-to-br from-white/8 to-white/3 border border-white/10 rounded-2xl p-6 hover:border-blue-500/40 hover:from-blue-600/15 hover:to-blue-600/5 transition-all duration-300 backdrop-blur-sm">
              <div class="icon w-20 h-20 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center flex-shrink-0 shadow-lg shadow-blue-500/10">
                <i data-lucide="users" class="w-10 h-10 text-blue-400"></i>
              </div>
              <div class="item">
                <div class="indc text-gray-400 text-sm mb-2 uppercase tracking-wider" style="font-weight: 500;">Employees</div>
                <div class="numU flex items-baseline gap-1">
                  <span class="numCX text-4xl font-bold text-white" style="font-weight: 900;">1300</span>
                  <span class="numC text-xl text-blue-400" style="font-weight: 600;">+</span>
                </div>
              </div>
            </li>

            <li class="flex items-center gap-6 bg-gradient-to-br from-white/8 to-white/3 border border-white/10 rounded-2xl p-6 hover:border-blue-500/40 hover:from-blue-600/15 hover:to-blue-600/5 transition-all duration-300 backdrop-blur-sm">
              <div class="icon w-20 h-20 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center flex-shrink-0 shadow-lg shadow-blue-500/10">
                <i data-lucide="building-2" class="w-10 h-10 text-blue-400"></i>
              </div>
              <div class="item">
                <div class="indc text-gray-400 text-sm mb-2 uppercase tracking-wider" style="font-weight: 500;">Registered Capital</div>
                <div class="numU flex items-baseline gap-1">
                  <span class="numCX text-4xl font-bold text-white" style="font-weight: 900;">158</span>
                  <span class="numC text-lg text-gray-400" style="font-weight: 500;">Million</span>
                </div>
              </div>
            </li>

            <li class="flex items-center gap-6 bg-gradient-to-br from-white/8 to-white/3 border border-white/10 rounded-2xl p-6 hover:border-blue-500/40 hover:from-blue-600/15 hover:to-blue-600/5 transition-all duration-300 backdrop-blur-sm">
              <div class="icon w-20 h-20 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center flex-shrink-0 shadow-lg shadow-blue-500/10">
                <i data-lucide="award" class="w-10 h-10 text-blue-400"></i>
              </div>
              <div class="item">
                <div class="indc text-gray-400 text-sm mb-2 uppercase tracking-wider" style="font-weight: 500;">Authorized Patents</div>
                <div class="numU flex items-baseline gap-1">
                  <span class="numCX text-4xl font-bold text-white" style="font-weight: 900;">243</span>
                  <span class="numC text-lg text-gray-400" style="font-weight: 500;">Items</span>
                </div>
              </div>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- Main 2: Corporate Culture -->
  <section class="main2 relative py-20 md:py-32 overflow-hidden bg-[#070b12]" id="main2">
    <div class="absolute -left-32 top-1/3 w-[500px] h-[500px] bg-blue-800/10 rounded-full filter blur-[150px] pointer-events-none"></div>
    <div class="absolute -right-32 bottom-1/4 w-[500px] h-[500px] bg-blue-600/10 rounded-full filter blur-[150px] pointer-events-none"></div>

    <div class="container max-w-7xl mx-auto relative z-10 px-8 md:px-16">
      <div class="title text-center mb-16">
        <h3 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-white mb-3" style="font-weight: 900;">Corporate Culture</h3>
        <span class="text-sm text-blue-400 uppercase tracking-widest" style="font-weight: 600;">corporate culture</span>
      </div>

      <div class="content">
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">

          <li class="group">
            <div class="h-full p-8 rounded-2xl bg-gradient-to-br from-white/8 to-white/3 border border-white/10 hover:border-blue-500/40 hover:from-blue-600/15 hover:to-blue-600/5 transition-all duration-300 text-center backdrop-blur-sm">
              <div class="icon w-20 h-20 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-blue-500/20 transition-all">
                <i data-lucide="eye" class="w-10 h-10 text-blue-400"></i>
              </div>
              <div class="text">
                <h4 class="text-xl font-bold text-white mb-4" style="font-weight: 700;">Corporate Vision</h4>
                <p class="text-gray-400 text-sm leading-relaxed" style="font-weight: 400;">
                  Build a world-class brand with innovative tools<br>
                  Provide cutting solutions for global manufacturing
                </p>
              </div>
            </div>
          </li>

          <li class="group">
            <div class="h-full p-8 rounded-2xl bg-gradient-to-br from-white/8 to-white/3 border border-white/10 hover:border-blue-500/40 hover:from-blue-600/15 hover:to-blue-600/5 transition-all duration-300 text-center backdrop-blur-sm">
              <div class="icon w-20 h-20 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-blue-500/20 transition-all">
                <i data-lucide="target" class="w-10 h-10 text-blue-400"></i>
              </div>
              <div class="text">
                <h4 class="text-xl font-bold text-white mb-4" style="font-weight: 700;">Corporate Mission</h4>
                <p class="text-gray-400 text-sm leading-relaxed" style="font-weight: 400;">
                  Innovate cutting tool technology for value creation<br>
                  Serve customers with excellence and professionalism
                </p>
              </div>
            </div>
          </li>

          <li class="group">
            <div class="h-full p-8 rounded-2xl bg-gradient-to-br from-white/8 to-white/3 border border-white/10 hover:border-blue-500/40 hover:from-blue-600/15 hover:to-blue-600/5 transition-all duration-300 text-center backdrop-blur-sm">
              <div class="icon w-20 h-20 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-blue-500/20 transition-all">
                <i data-lucide="compass" class="w-10 h-10 text-blue-400"></i>
              </div>
              <div class="text">
                <h4 class="text-xl font-bold text-white mb-4" style="font-weight: 700;">Core Values</h4>
                <p class="text-gray-400 text-sm leading-relaxed" style="font-weight: 400;">
                  Innovation-driven, Quality-focused<br>
                  Customer-centric, Integrity-based
                </p>
              </div>
            </div>
          </li>

          <li class="group">
            <div class="h-full p-8 rounded-2xl bg-gradient-to-br from-white/8 to-white/3 border border-white/10 hover:border-blue-500/40 hover:from-blue-600/15 hover:to-blue-600/5 transition-all duration-300 text-center backdrop-blur-sm">
              <div class="icon w-20 h-20 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center mx-auto mb-6 group-hover:scale-110 group-hover:shadow-lg group-hover:shadow-blue-500/20 transition-all">
                <i data-lucide="users" class="w-10 h-10 text-blue-400"></i>
              </div>
              <div class="text">
                <h4 class="text-xl font-bold text-white mb-4" style="font-weight: 700;">Talent Philosophy</h4>
                <p class="text-gray-400 text-sm leading-relaxed" style="font-weight: 400;">
                  Respect talent, Cultivate expertise<br>
                  Create opportunities for growth and success
                </p>
              </div>
            </div>
          </li>

        </ul>
      </div>
    </div>
  </section>

  <!-- Main 3: Development History -->
  <section class="main3 relative py-20 md:py-32 overflow-hidden bg-[#05070c]" id="main3">
    <div class="absolute -left-32 bottom-1/4 w-[500px] h-[500px] bg-blue-900/15 rounded-full filter blur-[150px] pointer-events-none"></div>
    <div class="absolute -right-32 top-1/4 w-[500px] h-[500px] bg-blue-600/10 rounded-full filter blur-[150px] pointer-events-none"></div>

    <div class="container max-w-7xl mx-auto relative z-10 px-8 md:px-16">
      <div class="title text-center mb-20">
        <h3 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-white mb-3" style="font-weight: 900;">Development History</h3>
        <span class="text-sm text-blue-400 uppercase tracking-widest" style="font-weight: 600;">development history</span>
      </div>

      <div class="content relative">

        <!-- Swiper Container -->
        <div class="swiper-container history-swiper overflow-hidden relative pb-4">

          <!-- Timeline Line (absolute positioned) -->
          <div class="absolute top-4 left-0 right-0 h-0.5 bg-blue-500/30 z-0"></div>

          <div class="swiper-wrapper">

            <div class="swiper-slide">
              <div class="relative">
                <!-- Timeline Dot -->
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-blue-500 border-2 border-[#05070c] shadow-lg shadow-blue-500/50 z-10"></div>

                <!-- Vertical Line -->
                <div class="absolute top-4 left-1/2 -translate-x-1/2 w-0.5 h-16 bg-blue-500/30"></div>

                <!-- Content -->
                <div class="pt-24 text-center">
                  <div class="tt text-4xl md:text-5xl font-bold text-blue-400 mb-6" style="font-weight: 900;">1996</div>
                  <div class="text text-gray-300 text-sm md:text-base leading-relaxed px-4" style="font-weight: 400;">
                    <p>Company established</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="swiper-slide">
              <div class="relative">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-blue-500 border-2 border-[#05070c] shadow-lg shadow-blue-500/50 z-10"></div>
                <div class="absolute top-4 left-1/2 -translate-x-1/2 w-0.5 h-16 bg-blue-500/30"></div>

                <div class="pt-24 text-center">
                  <div class="tt text-4xl md:text-5xl font-bold text-blue-400 mb-6" style="font-weight: 900;">2008</div>
                  <div class="text text-gray-300 text-sm md:text-base leading-relaxed px-4" style="font-weight: 400;">
                    <p>Became the world's largest R&D and production enterprise for saw blades</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="swiper-slide">
              <div class="relative">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-blue-500 border-2 border-[#05070c] shadow-lg shadow-blue-500/50 z-10"></div>
                <div class="absolute top-4 left-1/2 -translate-x-1/2 w-0.5 h-16 bg-blue-500/30"></div>

                <div class="pt-24 text-center">
                  <div class="tt text-4xl md:text-5xl font-bold text-blue-400 mb-6" style="font-weight: 900;">2010</div>
                  <div class="text text-gray-300 text-sm md:text-base leading-relaxed px-4" style="font-weight: 400;">
                    <p>Lusong production base completed</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="swiper-slide">
              <div class="relative">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-blue-500 border-2 border-[#05070c] shadow-lg shadow-blue-500/50 z-10"></div>
                <div class="absolute top-4 left-1/2 -translate-x-1/2 w-0.5 h-16 bg-blue-500/30"></div>

                <div class="pt-24 text-center">
                  <div class="tt text-4xl md:text-5xl font-bold text-blue-400 mb-6" style="font-weight: 900;">2011</div>
                  <div class="text text-gray-300 text-sm md:text-base leading-relaxed px-4" style="font-weight: 400;">
                    <p>High-precision CNC inserts officially put into production</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="swiper-slide">
              <div class="relative">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-blue-500 border-2 border-[#05070c] shadow-lg shadow-blue-500/50 z-10"></div>
                <div class="absolute top-4 left-1/2 -translate-x-1/2 w-0.5 h-16 bg-blue-500/30"></div>

                <div class="pt-24 text-center">
                  <div class="tt text-4xl md:text-5xl font-bold text-blue-400 mb-6" style="font-weight: 900;">2017</div>
                  <div class="text text-gray-300 text-sm md:text-base leading-relaxed px-4" style="font-weight: 400;">
                    <p>Yanling production base completed</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="swiper-slide">
              <div class="relative">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-blue-500 border-2 border-[#05070c] shadow-lg shadow-blue-500/50 z-10"></div>
                <div class="absolute top-4 left-1/2 -translate-x-1/2 w-0.5 h-16 bg-blue-500/30"></div>

                <div class="pt-24 text-center">
                  <div class="tt text-4xl md:text-5xl font-bold text-blue-400 mb-6" style="font-weight: 900;">2020</div>
                  <div class="text text-gray-300 text-sm md:text-base leading-relaxed px-4" style="font-weight: 400;">
                    <p>Listed on the Science and Technology Innovation Board (Stock Code: 688308)</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="swiper-slide">
              <div class="relative">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-blue-500 border-2 border-[#05070c] shadow-lg shadow-blue-500/50 z-10"></div>
                <div class="absolute top-4 left-1/2 -translate-x-1/2 w-0.5 h-16 bg-blue-500/30"></div>

                <div class="pt-24 text-center">
                  <div class="tt text-4xl md:text-5xl font-bold text-blue-400 mb-6" style="font-weight: 900;">2021</div>
                  <div class="text text-gray-300 text-sm md:text-base leading-relaxed px-4" style="font-weight: 400;">
                    <p>Solid carbide tools and CNC tool body R&D project launched</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="swiper-slide">
              <div class="relative">
                <div class="absolute top-0 left-1/2 -translate-x-1/2 w-4 h-4 rounded-full bg-blue-500 border-2 border-[#05070c] shadow-lg shadow-blue-500/50 z-10"></div>
                <div class="absolute top-4 left-1/2 -translate-x-1/2 w-0.5 h-16 bg-blue-500/30"></div>

                <div class="pt-24 text-center">
                  <div class="tt text-4xl md:text-5xl font-bold text-blue-400 mb-6" style="font-weight: 900;">2024</div>
                  <div class="text text-gray-300 text-sm md:text-base leading-relaxed px-4" style="font-weight: 400;">
                    <p>Tianyuan District production base completed</p>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Navigation Buttons -->
        <div class="main3-button-prev absolute left-4 md:left-0 top-0 z-10 w-12 h-12 rounded-full bg-gray-700/80 hover:bg-gray-600 flex items-center justify-center cursor-pointer transition-all shadow-lg">
          <i data-lucide="chevron-left" class="w-6 h-6 text-white"></i>
        </div>
        <div class="main3-button-next absolute right-4 md:right-0 top-0 z-10 w-12 h-12 rounded-full bg-gray-700/80 hover:bg-gray-600 flex items-center justify-center cursor-pointer transition-all shadow-lg">
          <i data-lucide="chevron-right" class="w-6 h-6 text-white"></i>
        </div>
      </div>
    </div>
  </section>

</MainLayout>

<script>
  import Swiper from 'swiper';
  import { Navigation } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';

  // Initialize Swiper for history timeline
  new Swiper('.history-swiper', {
    modules: [Navigation],
    slidesPerView: 1,
    spaceBetween: 20,
    navigation: {
      nextEl: '.main3-button-next',
      prevEl: '.main3-button-prev',
    },
    breakpoints: {
      640: {
        slidesPerView: 2,
        spaceBetween: 20,
      },
      768: {
        slidesPerView: 3,
        spaceBetween: 24,
      },
      1024: {
        slidesPerView: 4,
        spaceBetween: 24,
      },
    },
  });
</script>

<style>
  .swiper-slide {
    height: auto;
  }
</style>
