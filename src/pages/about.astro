---
import MainLayout from '@/layouts/MainLayout.astro';
import { getPageById } from '@/lib/wordpress';

// 直接通过 ID 获取 About 页面的 ACF 数据（字段完全保留）
let pageData = null;
try {
  pageData = await getPageById(45697);
} catch (e) {
  console.error('Error fetching about page:', e);
}

const acf = pageData?.acf || {};

// ================= 图片与背景 URL 集中预留区 =================
// 1. 顶部 Hero Banner 大图
let heroImage = 'https://images.unsplash.com/photo-1581092918056-0c4c3acd3789?auto=format&fit=crop&w=2400&q=80';
if (acf.hero_image) {
  if (typeof acf.hero_image === 'string') {
    heroImage = acf.hero_image;
  } else if (typeof acf.hero_image === 'number') {
    try {
      const mediaResponse = await fetch(`https://darkgrey-woodcock-712173.hostingersite.com/wp-json/wp/v2/media/${acf.hero_image}`);
      if (mediaResponse.ok) {
        const mediaData = await mediaResponse.json();
        heroImage = mediaData.source_url || heroImage;
      }
    } catch (e) {
      console.error('Error fetching hero image:', e);
    }
  } else if (acf.hero_image.url) {
    heroImage = acf.hero_image.url;
  }
}

// 2. 蓝色科技光流背景图 URL (贯穿 Corporate Culture 标题与白色卡片上半部分)
const cultureSectionBg = acf.culture_bg_image || 'https://darkgrey-woodcock-712173.hostingersite.com/wp-content/uploads/2026/10/关于我们背景1.png';

// 3. 第二部分 3 个文化卡片的自定义图标 URL（留空则默认渲染矢量图标）
const cultureIconVision = acf.culture_icon_vision || 'https://darkgrey-woodcock-712173.hostingersite.com/wp-content/uploads/2026/10/未标题-1.png';
const cultureIconMission = acf.culture_icon_mission || 'https://darkgrey-woodcock-712173.hostingersite.com/wp-content/uploads/2026/10/未标题-2.png';
const cultureIconValues = acf.culture_icon_values || 'https://darkgrey-woodcock-712173.hostingersite.com/wp-content/uploads/2026/10/未标题-3.png';

// 4. 下半部分浅色透视经纬网格背景图 URL
const journeySectionBg = acf.journey_bg_image || 'https://darkgrey-woodcock-712173.hostingersite.com/wp-content/uploads/2026/10/关于我们背景2.png';
---

<MainLayout title="About Us - ARESTUN">

  <!-- ================= 1. 顶部全屏 Factory Banner ================= -->
  <div class="nybanner relative h-[420px] md:h-[560px] lg:h-[620px] overflow-hidden">
    <img src={heroImage} class="absolute inset-0 w-full h-full object-cover object-center brightness-95" alt="About Us Banner" />
    <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/30 pointer-events-none"></div>
  </div>

  <!-- ================= 2. Breadcrumb 面包屑与锚点导航（严格 Medium 字体） ================= -->
  <div class="crumb bg-white border-b border-gray-100 py-3.5 shadow-sm sticky top-0 z-30">
    <div class="container max-w-7xl mx-auto px-6 md:px-12 lg:px-16 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
      <div class="left flex items-center text-xs md:text-sm text-gray-500 font-medium">
        <i data-lucide="home" class="w-4 h-4 mr-1.5 text-gray-400"></i>
        <a href="/" class="hover:text-blue-600 transition-colors">HOME</a>
        <span class="mx-2 text-gray-300">&gt;</span>
        <span class="text-blue-600 uppercase" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">ABOUT US</span>
      </div>
      <div class="right">
        <ul class="flex items-center gap-8 text-xs md:text-sm text-gray-600" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
          <li>
            <a href="#company-intro" class="text-blue-600 border-b-2 border-blue-600 pb-1 font-semibold">Company Profile</a>
          </li>
          <li>
            <a href="#corporate-culture" class="hover:text-blue-600 transition-colors pb-1">Corporate Culture</a>
          </li>
          <li>
            <a href="#our-journey" class="hover:text-blue-600 transition-colors pb-1">Development History</a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- ================= 3. 第一部分：Company Introduction ================= -->
  <section class="relative py-16 md:py-24 px-6 md:px-12 lg:px-16 bg-[#f8faff] overflow-hidden" id="company-intro">
    <div class="container max-w-7xl mx-auto relative z-10">
      <div class="flex flex-col lg:flex-row justify-between gap-12 lg:gap-16 items-start">

        <!-- 左侧文本详情 -->
        <div class="flex-1 max-w-3xl">
          <div class="mb-6">
            <h2 class="text-3xl md:text-4xl lg:text-[2.6rem] text-gray-900 tracking-tight mb-2 leading-tight" style="font-family: 'Inter-Black', 'Inter', sans-serif; font-weight: 900;">
              {acf.intro_title || "COMPANY INTRODUCTION"}
            </h2>
            <div class="text-sm md:text-base text-blue-600 tracking-wide" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
              Wenling Shanwei E-Commerce Co., Ltd.
            </div>
          </div>

          <div class="space-y-4 text-gray-600 text-[13px] md:text-sm leading-relaxed text-justify" style="font-family: 'Inter-Regular', 'Inter', sans-serif;">
            {acf.intro_content ? (
              <div class="prose max-w-none text-gray-600" set:html={acf.intro_content} />
            ) : (
              <>
                <p>
                  Wenling Shanwei E-Commerce Co., Ltd., founded in 2005, is a professional and reliable enterprise specializing in the R&D, sales and technical service of CNC cutting tools, measuring tools, cutting tools, hardware products and related accessories. With years of deep cultivation in the cutting tool and hardware industry, the company has accumulated rich industry experience and mature supply chain resources, committing to providing high-quality, cost-effective and diversified industrial products for domestic and global customers.
                </p>
                <p>
                  Focusing on product quality and market demand, the company strictly controls product selection, quality inspection and after-sales service in every link. Its core product portfolio covers a full range of high-precision CNC cutting tools, professional measuring and cutting tools, and standard and customized hardware products, which are widely applicable in mechanical processing, mold manufacturing, automobile manufacturing, hardware processing and other fields. Adhering to the market-oriented development strategy, the company keeps optimizing product structure, upgrading product performance, and launching cost-effective products that adapt to diverse processing scenarios, effectively meeting the personalized and high-standard procurement needs of industrial customers.
                </p>
                <p>
                  The company has always adhered to the development philosophy of "quality first, customer-oriented, innovation-driven, and integrity-based". It has built a professional service and operation team with proficient industry knowledge and rich practical experience, and has established long-term stable cooperative relations with numerous manufacturers and customers at home and abroad. Relying on standardized operation management and perfect service system, the company continuously improves customer service quality and market response efficiency.
                </p>
                <p>
                  Upholding the corporate values of integrity, pragmatism, innovation and win-win, Wenling Shanwei E-Commerce Co., Ltd. will continue to focus on the field of CNC tools and hardware products, keep exploring and innovating, strive to provide more professional product solutions and high-quality services for global customers, and create greater value for the industrial manufacturing industry.
                </p>
              </>
            )}
          </div>
        </div>

        <!-- 右侧三大指标卡片 -->
        <div class="w-full lg:w-[320px] flex-shrink-0 flex flex-col gap-4 self-center lg:self-start pt-2">
          
          <!-- 卡片 1: EXPERIENCE 20+ -->
          <div class="flex items-center gap-4 bg-white/95 backdrop-blur-sm p-4 px-5 rounded-2xl border border-gray-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_8px_25px_rgba(37,99,235,0.08)] transition-all">
            <div class="w-14 h-14 rounded-2xl bg-[#e0efff] flex items-center justify-center flex-shrink-0 text-blue-600">
              <i data-lucide="gem" class="w-7 h-7"></i>
            </div>
            <div>
              <div class="text-[10px] uppercase font-mono tracking-wider text-gray-400 font-semibold">EXPERIENCE</div>
              <div class="text-3xl text-gray-900 tracking-tight leading-none mt-1" style="font-family: 'Inter-Black', 'Inter', sans-serif; font-weight: 900;">
                {acf.stats?.employees || "20+"}
              </div>
            </div>
          </div>

          <!-- 卡片 2: FACTORY AREA 22000 -->
          <div class="flex items-center gap-4 bg-white/95 backdrop-blur-sm p-4 px-5 rounded-2xl border border-gray-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_8px_25px_rgba(37,99,235,0.08)] transition-all">
            <div class="w-14 h-14 rounded-2xl bg-[#e4ebff] flex items-center justify-center flex-shrink-0 text-[#4f46e5]">
              <i data-lucide="building-2" class="w-7 h-7"></i>
            </div>
            <div>
              <div class="text-[10px] uppercase font-mono tracking-wider text-gray-400 font-semibold">FACTORY AREA</div>
              <div class="text-3xl text-gray-900 tracking-tight leading-none mt-1" style="font-family: 'Inter-Black', 'Inter', sans-serif; font-weight: 900;">
                {acf.stats?.capital || "22000"}
              </div>
            </div>
          </div>

          <!-- 卡片 3: ANNUAL OUTPUT VALUE 13 million -->
          <div class="flex items-center gap-4 bg-white/95 backdrop-blur-sm p-4 px-5 rounded-2xl border border-gray-100 shadow-[0_4px_20px_rgba(0,0,0,0.03)] hover:shadow-[0_8px_25px_rgba(37,99,235,0.08)] transition-all">
            <div class="w-14 h-14 rounded-2xl bg-[#ede9fe] flex items-center justify-center flex-shrink-0 text-[#7c3aed]">
              <i data-lucide="award" class="w-7 h-7"></i>
            </div>
            <div>
              <div class="text-[9px] uppercase font-mono tracking-wider text-gray-400 font-semibold">ANNUAL OUTPUTVALUE</div>
              <div class="flex items-baseline mt-1 leading-none">
                <span class="text-3xl text-gray-900 tracking-tight" style="font-family: 'Inter-Black', 'Inter', sans-serif; font-weight: 900;">
                  {acf.stats?.patents || "13"}
                </span>
                <span class="text-sm font-bold text-gray-900 ml-1" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
                  million
                </span>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- ================= 4 & 5. 第二、三部分无缝融合容器 ================= -->
  <div class="relative w-full overflow-hidden" id="corporate-culture">

    <!-- 背景层 A：全宽蓝色科技光流背景（保持您设定的精确高度尺寸） -->
    <div
      class="absolute top-0 left-0 right-0 h-[480px] md:h-[480px] bg-cover bg-center pointer-events-none select-none z-0"
      style={`background-image: url('${cultureSectionBg}'); background-color: #0055ff;`}
    >
      <div class="absolute inset-0 bg-gradient-to-r from-blue-700/20 via-transparent to-blue-900/30"></div>
    </div>

    <!-- 背景层 B：浅色透视经纬网格背景（移除导致隐形的 mix-blend-multiply，提升不透明度确保正常清晰显示） -->
    <div
      class="absolute top-[420px] md:top-[300px] bottom-0 left-0 right-0 bg-cover bg-top pointer-events-none select-none  z-0"
      style={`background-image: url('${journeySectionBg}');`}
    ></div>

    <!-- 前景内容层：宽度加宽至 max-w-[1360px] -->
    <div class="relative z-10 container max-w-[1360px] mx-auto px-6 md:px-10 lg:px-12 pt-16 md:pt-20 pb-24 md:pb-32">
      
      <!-- 居中标题：置于纯蓝光背景中 -> Black (900) -->
      <div class="text-center mb-10 md:mb-12">
        <h2 class="text-3xl md:text-5xl text-white tracking-tight" style="font-family: 'Inter-Black', 'Inter', sans-serif; font-weight: 900;">
          {acf.culture_title || "Corporate Culture"}
        </h2>
      </div>

      <!-- 核心大圆角白色浮层卡片：加宽布局更舒展，带深蓝环境柔光阴影 -->
      <div class="w-full bg-white rounded-[2.2rem] md:rounded-[2.85rem] p-8 md:p-14 lg:p-16 border border-white/80 shadow-[0_30px_70px_-15px_rgba(0,50,160,0.18)] mb-24 md:mb-32">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-8 lg:gap-14 text-center">

          <!-- 卡片 1: Corporate Vision -->
          <div class="flex flex-col items-center">
            <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-[#0062ff] to-[#00a6ff] flex items-center justify-center text-white mb-6 shadow-[0_10px_25px_rgba(0,98,255,0.35)]">
              {cultureIconVision ? (
                <img src={cultureIconVision} alt="Corporate Vision" class="w-10 h-10 object-contain" />
              ) : (
                <i data-lucide="send" class="w-9 h-9"></i>
              )}
            </div>
            <!-- 标题 -> Bold (700) -->
            <h3 class="text-xl md:text-2xl text-[#11244d] mb-4" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
              Corporate Vision
            </h3>
            <!-- 描述 -> Medium (500) -->
            <p class="text-gray-500 text-xs md:text-sm leading-relaxed max-w-sm" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
              With reliable cutting tools and sophisticated processing technology, we strive to become a globally renowned brand in CNC machining industry.
            </p>
          </div>

          <!-- 卡片 2: Corporate Mission -->
          <div class="flex flex-col items-center">
            <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-[#0062ff] to-[#00a6ff] flex items-center justify-center text-white mb-6 shadow-[0_10px_25px_rgba(0,98,255,0.35)]">
              {cultureIconMission ? (
                <img src={cultureIconMission} alt="Corporate Mission" class="w-10 h-10 object-contain" />
              ) : (
                <i data-lucide="target" class="w-9 h-9"></i>
              )}
            </div>
            <!-- 标题 -> Bold (700) -->
            <h3 class="text-xl md:text-2xl text-[#11244d] mb-4" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
              Corporate Mission
            </h3>
            <!-- 描述 -> Medium (500) -->
            <p class="text-gray-500 text-xs md:text-sm leading-relaxed max-w-sm" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
              To deliver stable & efficient machining solutions for customers, for high-quality manufacturing and a green industrial ecosystem.
            </p>
          </div>

          <!-- 卡片 3: Core Values -->
          <div class="flex flex-col items-center">
            <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-[#0062ff] to-[#00a6ff] flex items-center justify-center text-white mb-6 shadow-[0_10px_25px_rgba(0,98,255,0.35)]">
              {cultureIconValues ? (
                <img src={cultureIconValues} alt="Core Values" class="w-10 h-10 object-contain" />
              ) : (
                <i data-lucide="lightbulb" class="w-9 h-9"></i>
              )}
            </div>
            <!-- 标题 -> Bold (700) -->
            <h3 class="text-xl md:text-2xl text-[#11244d] mb-4" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
              Core Values
            </h3>
            <!-- 描述 -> Medium (500) -->
            <p class="text-gray-500 text-xs md:text-sm leading-relaxed max-w-sm" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
              Customer-centric, quality-oriented, integrity-grounded, and persistent in pursuit of precision.
            </p>
          </div>

        </div>
      </div>

      <!-- ================= 5. Our Journey 区域 ================= -->
      <div id="our-journey" class="relative w-full max-w-6xl mx-auto">
        <h2 class="text-3xl md:text-5xl text-gray-900 tracking-tight mb-20 text-center" style="font-family: 'Inter-Black', 'Inter', sans-serif; font-weight: 900;">
          {acf.timeline_title || "Our Journey"}
        </h2>

        <!-- 时间轴 Swiper 轮播容器 -->
        <div class="relative px-8 md:px-14">
          <!-- 水平中央基准连线 -->
          <div class="absolute top-[28px] left-12 right-12 h-[2px] bg-blue-500/25 z-0"></div>

          <div class="swiper-container journey-swiper overflow-hidden relative">
            <div class="swiper-wrapper">

              <!-- 节点 1: 2005 -->
              <div class="swiper-slide text-center flex flex-col items-center">
                <div class="w-4 h-4 rounded-full bg-blue-600 border-4 border-white shadow-md z-10 mb-8 mx-auto"></div>
                <div class="text-4xl md:text-5xl text-[#2272eb] mb-1 leading-none" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
                  2005
                </div>
                <div class="text-xs uppercase tracking-wider text-blue-600 font-semibold mb-3" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
                  Foundation Established
                </div>
                <p class="text-gray-600 text-xs md:text-[13px] leading-relaxed max-w-[210px] mx-auto font-normal">
                  The company was founded, officially launching the business of CNC cutting tools, measuring tools and hardware products.
                </p>
              </div>

              <!-- 节点 2: 2007 -->
              <div class="swiper-slide text-center flex flex-col items-center">
                <div class="w-4 h-4 rounded-full bg-blue-600 border-4 border-white shadow-md z-10 mb-8 mx-auto"></div>
                <div class="text-4xl md:text-5xl text-[#2272eb] mb-1 leading-none" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
                  2007
                </div>
                <div class="text-xs uppercase tracking-wider text-blue-600 font-semibold mb-3" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
                  Equipment Upgrade
                </div>
                <p class="text-gray-600 text-xs md:text-[13px] leading-relaxed max-w-[210px] mx-auto font-normal">
                  Introduced modern advanced production and testing equipment to standardize production, improve product accuracy and overall quality stability.
                </p>
              </div>

              <!-- 节点 3: 2012 -->
              <div class="swiper-slide text-center flex flex-col items-center">
                <div class="w-4 h-4 rounded-full bg-blue-600 border-4 border-white shadow-md z-10 mb-8 mx-auto"></div>
                <div class="text-4xl md:text-5xl text-[#2272eb] mb-1 leading-none" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
                  2012
                </div>
                <div class="text-xs uppercase tracking-wider text-blue-600 font-semibold mb-3" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
                  Capacity Expansion
                </div>
                <p class="text-gray-600 text-xs md:text-[13px] leading-relaxed max-w-[210px] mx-auto font-normal">
                  Expanded new factory premises, optimized production layout, and greatly boosted manufacturing capacity and scale.
                </p>
              </div>

              <!-- 节点 4: 2016 -->
              <div class="swiper-slide text-center flex flex-col items-center">
                <div class="w-4 h-4 rounded-full bg-blue-600 border-4 border-white shadow-md z-10 mb-8 mx-auto"></div>
                <div class="text-4xl md:text-5xl text-[#2272eb] mb-1 leading-none" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
                  2016
                </div>
                <div class="text-xs uppercase tracking-wider text-blue-600 font-semibold mb-3" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
                  Digital Transformation
                </div>
                <p class="text-gray-600 text-xs md:text-[13px] leading-relaxed max-w-[210px] mx-auto font-normal">
                  Entered the e-commerce sector, opened online sales channels, and realized rapid expansion of the domestic market.
                </p>
              </div>

              <!-- 节点 5: 2018 -->
              <div class="swiper-slide text-center flex flex-col items-center">
                <div class="w-4 h-4 rounded-full bg-blue-600 border-4 border-white shadow-md z-10 mb-8 mx-auto"></div>
                <div class="text-4xl md:text-5xl text-[#2272eb] mb-1 leading-none" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
                  2018
                </div>
                <div class="text-xs uppercase tracking-wider text-blue-600 font-semibold mb-3" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
                  Global Layout
                </div>
                <p class="text-gray-600 text-xs md:text-[13px] leading-relaxed max-w-[210px] mx-auto font-normal">
                  Set up the foreign trade department, officially started overseas business and began global market expansion.
                </p>
              </div>

              <!-- 节点 6: 2022 -->
              <div class="swiper-slide text-center flex flex-col items-center">
                <div class="w-4 h-4 rounded-full bg-blue-600 border-4 border-white shadow-md z-10 mb-8 mx-auto"></div>
                <div class="text-4xl md:text-5xl text-[#2272eb] mb-1 leading-none" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
                  2022
                </div>
                <div class="text-xs uppercase tracking-wider text-blue-600 font-semibold mb-3" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
                  Team Scaling-up
                </div>
                <p class="text-gray-600 text-xs md:text-[13px] leading-relaxed max-w-[210px] mx-auto font-normal">
                  Completed team iteration and expansion, with a professional team of 88 members covering sales, operation, technology and after-sales.
                </p>
              </div>

              <!-- 节点 7: 2024 -->
              <div class="swiper-slide text-center flex flex-col items-center">
                <div class="w-4 h-4 rounded-full bg-blue-600 border-4 border-white shadow-md z-10 mb-8 mx-auto"></div>
                <div class="text-4xl md:text-5xl text-[#2272eb] mb-1 leading-none" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
                  2024
                </div>
                <div class="text-xs uppercase tracking-wider text-blue-600 font-semibold mb-3" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
                  Sales Milestone
                </div>
                <p class="text-gray-600 text-xs md:text-[13px] leading-relaxed max-w-[210px] mx-auto font-normal">
                  Reached an annual sales volume of 15 million units, achieving a new breakthrough in market scale and industry influence.
                </p>
              </div>

              <!-- 节点 8: 2025 -->
              <div class="swiper-slide text-center flex flex-col items-center">
                <div class="w-4 h-4 rounded-full bg-blue-600 border-4 border-white shadow-md z-10 mb-8 mx-auto"></div>
                <div class="text-4xl md:text-5xl text-[#2272eb] mb-1 leading-none" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
                  2025
                </div>
                <div class="text-xs uppercase tracking-wider text-blue-600 font-semibold mb-3" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
                  High-quality Development
                </div>
                <p class="text-gray-600 text-xs md:text-[13px] leading-relaxed max-w-[210px] mx-auto font-normal">
                  Further optimized supply chain system, enriched product lines, focused on high-precision tool customization and integrated services.
                </p>
              </div>

            </div>
          </div>

          <!-- 左右圆钮切换键 -->
          <button class="journey-prev absolute -left-2 top-[6px] z-20 w-11 h-11 rounded-full bg-[#1e293b]/85 hover:bg-black text-white flex items-center justify-center transition-all shadow-lg active:scale-95">
            <i data-lucide="chevron-left" class="w-5 h-5"></i>
          </button>
          <button class="journey-next absolute -right-2 top-[6px] z-20 w-11 h-11 rounded-full bg-[#1e293b]/85 hover:bg-black text-white flex items-center justify-center transition-all shadow-lg active:scale-95">
            <i data-lucide="chevron-right" class="w-5 h-5"></i>
          </button>

        </div>
      </div>

    </div>
  </div>

</MainLayout>

<!-- Swiper 交互初始化脚本 -->
<script>
  import Swiper from 'swiper';
  import { Navigation } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';

  new Swiper('.journey-swiper', {
    modules: [Navigation],
    slidesPerView: 1,
    spaceBetween: 24,
    navigation: {
      nextEl: '.journey-next',
      prevEl: '.journey-prev',
    },
    breakpoints: {
      640: {
        slidesPerView: 2,
        spaceBetween: 24,
      },
      768: {
        slidesPerView: 3,
        spaceBetween: 28,
      },
      1024: {
        slidesPerView: 4,
        spaceBetween: 32,
      },
    },
  });
</script>

<style>
  .swiper-slide {
    height: auto;
  }
</style>