---
// Floating Contact Widget
---

<!-- Floating Contact Button -->
<div id="floatingContact" class="fixed bottom-6 right-6 z-50" style="margin-bottom:70px;">

  <!-- Main Button (Chat Icon) 缩小 1/3，由 64px 缩为 44px (w-11 h-11) -->
  <button id="contactToggle" class="relative w-11 h-11 rounded-full bg-gradient-to-br from-blue-500 via-blue-600 to-blue-700 shadow-2xl hover:scale-110 transition-transform duration-300 flex items-center justify-center group">
    <!-- Online Status Dot 同步微调 -->
    <span class="absolute -top-0.5 -right-0.5 w-3 h-3 bg-green-500 rounded-full border-2 border-white animate-pulse"></span>

    <!-- Chat Icon 缩小 -->
    <i data-lucide="message-circle" class="w-5 h-5 text-white"></i>
  </button>

  <!-- Contact Panel (宽度收窄至 w-[245px]) -->
  <div id="contactPanel" class="hidden absolute bottom-16 right-0 w-[245px] rounded-2xl overflow-hidden shadow-2xl animate-slideUp border border-white/10">

    <!-- Header -->
    <div class="bg-gradient-to-r from-blue-500 via-blue-600 to-blue-700 p-3 relative">
      <button id="closePanel" class="absolute top-2 right-2 w-5 h-5 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center transition-colors">
        <i data-lucide="x" class="w-3 h-3 text-white"></i>
      </button>
      <!-- Talk to ARESTUN -> Bold (700) -->
      <h3 class="text-white text-sm tracking-tight mb-0.5 leading-snug" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
        Talk to ARESTUN
      </h3>
      <!-- Replies within 24h -> Medium (500) -->
      <p class="text-white/85 text-[10px] leading-tight" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
        Replies within 24h Mon-Sat
      </p>
    </div>

    <!-- Contact Options -->
    <div class="bg-[#0a0d14] p-2.5 space-y-1.5">

      <!-- WhatsApp -->
      <a href="https://wa.me/8617530263151" target="_blank" class="block p-2 rounded-lg border border-green-500/30 bg-green-500/5 hover:bg-green-500/10 transition-all group">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0">
            <i data-lucide="phone" class="w-3.5 h-3.5 text-white"></i>
          </div>
          <div class="flex-1 min-w-0">
            <!-- 标签标题 -> Bold -->
            <div class="text-green-400 text-[9px] uppercase tracking-wider" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
              WHATSAPP
            </div>
            <!-- 具体内容 -> Medium -->
            <div class="text-white text-[11px] truncate" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
              +86 175-3026-3151
            </div>
          </div>
        </div>
      </a>

      <!-- WeChat -->
      <div id="wechatBtn" class="block p-2 rounded-lg border border-green-500/30 bg-green-500/5 hover:bg-green-500/10 transition-all cursor-pointer group">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0">
            <i data-lucide="message-square" class="w-3.5 h-3.5 text-white"></i>
          </div>
          <div class="flex-1 min-w-0">
            <!-- 标签标题 -> Bold -->
            <div class="text-green-400 text-[9px] uppercase tracking-wider" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
              WECHAT (CLICK TO COPY)
            </div>
            <!-- 具体内容 -> Medium -->
            <div class="text-white text-[11px] truncate" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
              lumenlab_eyewear
            </div>
          </div>
        </div>
      </div>

      <!-- Email -->
      <a href="mailto:info@lumenlab.com" class="block p-2 rounded-lg border border-blue-500/30 bg-blue-500/5 hover:bg-blue-500/10 transition-all group">
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-full bg-blue-500 flex items-center justify-center flex-shrink-0">
            <i data-lucide="mail" class="w-3.5 h-3.5 text-white"></i>
          </div>
          <div class="flex-1 min-w-0">
            <!-- 标签标题 -> Bold -->
            <div class="text-blue-400 text-[9px] uppercase tracking-wider" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
              EMAIL
            </div>
            <!-- 具体内容 -> Medium -->
            <div class="text-white text-[11px] truncate" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
              info@lumenlab.com
            </div>
          </div>
        </div>
      </a>

      <!-- Language Info -->
      <div class="flex items-center gap-1.5 text-gray-400 text-[9px] pt-0.5 px-0.5 font-medium" style="font-family: 'Inter-Medium', 'Inter', sans-serif; font-weight: 500;">
        <span>🌐</span>
        <span>EN / ES / FR / 中文</span>
      </div>

    </div>
  </div>

</div>

<style>
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slideUp {
    animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Hide scrollbar for contact panel */
  #contactPanel::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('contactToggle');
    const closeBtn = document.getElementById('closePanel');
    const panel = document.getElementById('contactPanel');
    const wechatBtn = document.getElementById('wechatBtn');

    const AUTO_OPEN_INTERVAL = 30;
    const lastShown = localStorage.getItem('contactPanelLastShown');
    const now = Math.floor(Date.now() / 1000);

    if (panel) {
      if (!lastShown || (now - parseInt(lastShown)) > AUTO_OPEN_INTERVAL) {
        setTimeout(() => {
          panel.classList.remove('hidden');
          localStorage.setItem('contactPanelLastShown', now.toString());
        }, 3000);
      }
    }

    if (toggleBtn && panel && closeBtn) {
      toggleBtn.addEventListener('click', () => {
        panel.classList.toggle('hidden');
      });

      closeBtn.addEventListener('click', () => {
        panel.classList.add('hidden');
      });

      document.addEventListener('click', (e) => {
        const floatingContact = document.getElementById('floatingContact');
        if (floatingContact && !floatingContact.contains(e.target as Node)) {
          panel.classList.add('hidden');
        }
      });
    }

    if (wechatBtn) {
      wechatBtn.addEventListener('click', () => {
        navigator.clipboard.writeText('lumenlab_eyewear').then(() => {
          const originalText = wechatBtn.querySelector('.text-green-400')?.textContent;
          const statusElement = wechatBtn.querySelector('.text-green-400');
          if (statusElement) {
            statusElement.textContent = 'COPIED TO CLIPBOARD! ✓';
            setTimeout(() => {
              statusElement.textContent = originalText || 'WECHAT (CLICK TO COPY)';
            }, 2000);
          }
        }).catch(() => {
          alert('WeChat ID: lumenlab_eyewear');
        });
      });
    }
  });
</script>