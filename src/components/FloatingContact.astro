---
// Floating Contact Widget
---

<!-- Floating Contact Button -->
<div id="floatingContact" class="fixed bottom-6 right-6 z-50">

  <!-- Main Button (Chat Icon) -->
  <button id="contactToggle" class="relative w-16 h-16 rounded-full bg-gradient-to-br from-blue-500 via-blue-600 to-blue-700 shadow-2xl hover:scale-110 transition-transform duration-300 flex items-center justify-center group">
    <!-- Online Status Dot -->
    <span class="absolute -top-1 -right-1 w-4 h-4 bg-green-500 rounded-full border-2 border-white animate-pulse"></span>

    <!-- Chat Icon -->
    <i data-lucide="message-circle" class="w-8 h-8 text-white"></i>
  </button>

  <!-- Contact Panel (Hidden by default) -->
  <div id="contactPanel" class="hidden absolute bottom-20 right-0 w-[288px]  rounded-3xl overflow-hidden shadow-2xl animate-slideUp">

    <!-- Header -->
    <div class="bg-gradient-to-r from-blue-500 via-blue-600 to-blue-700 p-3 relative">
      <button id="closePanel" class="absolute top-2 right-2 w-6 h-6 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center transition-colors">
        <i data-lucide="x" class="w-3.5 h-3.5 text-white"></i>
      </button>
      <h3 class="text-white text-base font-bold mb-0.5" style="font-weight: 700;">Talk to LUMENLAB</h3>
      <p class="text-white/80 text-[10px]" style="font-weight: 400;">Replies within 24h · Mon—Sat</p>
    </div>

    <!-- Contact Options -->
    <div class="bg-[#0a0d14] p-3 space-y-2">

      <!-- WhatsApp -->
      <a href="https://wa.me/8617530263151" target="_blank" class="block p-2 rounded-lg border border-green-500/30 bg-green-500/5 hover:bg-green-500/10 transition-all group">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0">
            <i data-lucide="phone" class="w-4 h-4 text-white"></i>
          </div>
          <div class="flex-1">
            <div class="text-green-400 text-[10px] font-semibold" style="font-weight: 600;">WHATSAPP</div>
            <div class="text-white text-xs font-medium" style="font-weight: 500;">+86 175-3026-3151</div>
          </div>
        </div>
      </a>

      <!-- WeChat -->
      <div id="wechatBtn" class="block p-2 rounded-lg border border-green-500/30 bg-green-500/5 hover:bg-green-500/10 transition-all cursor-pointer group">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0">
            <i data-lucide="message-square" class="w-4 h-4 text-white"></i>
          </div>
          <div class="flex-1">
            <div class="text-green-400 text-[10px] font-semibold" style="font-weight: 600;">WECHAT (CLICK TO COPY)</div>
            <div class="text-white text-xs font-medium" style="font-weight: 500;">lumenlab_eyewear</div>
          </div>
        </div>
      </div>

      <!-- Email -->
      <a href="mailto:info@lumenlab.com" class="block p-2 rounded-lg border border-blue-500/30 bg-blue-500/5 hover:bg-blue-500/10 transition-all group">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center flex-shrink-0">
            <i data-lucide="mail" class="w-4 h-4 text-white"></i>
          </div>
          <div class="flex-1">
            <div class="text-blue-400 text-[10px] font-semibold" style="font-weight: 600;">EMAIL</div>
            <div class="text-white text-xs font-medium" style="font-weight: 500;">info@lumenlab.com</div>
          </div>
        </div>
      </a>

      <!-- Language Info -->
      <div class="flex items-center gap-1.5 text-gray-400 text-[10px] pt-1">
        <span>🌐</span>
        <span>EN / ES / FR / 中文</span>
      </div>

    </div>
  </div>

</div>

<style>
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slideUp {
    animation: slideUp 0.3s ease-out;
  }

  /* Hide scrollbar for contact panel */
  #contactPanel::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('contactToggle');
    const closeBtn = document.getElementById('closePanel');
    const panel = document.getElementById('contactPanel');
    const wechatBtn = document.getElementById('wechatBtn');

    // Auto open panel after 3 seconds - check every time based on timestamp
    const AUTO_OPEN_INTERVAL = 30; // 30 seconds interval
    const lastShown = localStorage.getItem('contactPanelLastShown');
    const now = Math.floor(Date.now() / 1000); // Current timestamp in seconds

    if (panel) {
      if (!lastShown || (now - parseInt(lastShown)) > AUTO_OPEN_INTERVAL) {
        setTimeout(() => {
          panel.classList.remove('hidden');
          localStorage.setItem('contactPanelLastShown', now.toString());
        }, 3000);
      }
    }

    if (toggleBtn && panel && closeBtn) {
      // Toggle panel
      toggleBtn.addEventListener('click', () => {
        panel.classList.toggle('hidden');
      });

      // Close panel
      closeBtn.addEventListener('click', () => {
        panel.classList.add('hidden');
      });

      // Close on outside click
      document.addEventListener('click', (e) => {
        const floatingContact = document.getElementById('floatingContact');
        if (floatingContact && !floatingContact.contains(e.target as Node)) {
          panel.classList.add('hidden');
        }
      });
    }

    // WeChat copy functionality
    if (wechatBtn) {
      wechatBtn.addEventListener('click', () => {
        navigator.clipboard.writeText('lumenlab_eyewear').then(() => {
          // Show temporary success message
          const originalText = wechatBtn.querySelector('.text-green-400')?.textContent;
          const statusElement = wechatBtn.querySelector('.text-green-400');
          if (statusElement) {
            statusElement.textContent = 'COPIED TO CLIPBOARD! ✓';
            setTimeout(() => {
              statusElement.textContent = originalText || 'WECHAT (CLICK TO COPY)';
            }, 2000);
          }
        }).catch(() => {
          alert('WeChat ID: lumenlab_eyewear');
        });
      });
    }
  });
</script>
