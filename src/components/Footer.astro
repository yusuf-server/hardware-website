---
import { getProductCategories, getApplicationCategories } from '@/lib/wordpress';

// 获取产品分类（只获取一级分类）
let productCategories = [];
try {
  const allCategories = await getProductCategories();
  productCategories = allCategories.filter(cat => cat.parent === 0).slice(0, 6);
} catch (e) {
  console.error('Error fetching product categories for footer:', e);
}

// 获取应用领域分类（只获取一级分类）
let applicationCategories = [];
try {
  const allCategories = await getApplicationCategories();
  applicationCategories = allCategories.filter(cat => cat.parent === 0).slice(0, 6);
} catch (e) {
  console.error('Error fetching application categories for footer:', e);
}
---

<!-- Footer -->
<footer class="relative flex flex-col justify-center px-10 md:px-24 lg:px-32 bg-[#0a0d14] text-gray-300 border-t border-white/5">
  <div class="w-full max-w-7xl mx-auto py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-8">

      <!-- PRODUCTS 列 -->
      <div class="md:col-span-4 flex flex-col gap-3">
        <h3 class="text-white font-bold text-sm tracking-widest uppercase mb-2">PRODUCTS</h3>
        <ul class="flex flex-col gap-2.5 text-xs text-gray-400">
          {productCategories.length > 0 ? (
            productCategories.map((category) => (
              <li>
                <a href={`/products#category-${category.id}`} class="hover:text-blue-400 transition-colors">
                  {category.name}
                </a>
              </li>
            ))
          ) : (
            <>
              <li><a href="/products" class="hover:text-blue-400 transition-colors">View All Products</a></li>
            </>
          )}
        </ul>
      </div>

      <!-- APPLICATIONS 列 -->
      <div class="md:col-span-3 flex flex-col gap-3">
        <h3 class="text-white font-bold text-sm tracking-widest uppercase mb-2">APPLICATIONS</h3>
        <ul class="flex flex-col gap-2.5 text-xs text-gray-400">
          {applicationCategories.length > 0 ? (
            applicationCategories.map((category) => (
              <li>
                <a href={`/applications#category-${category.id}`} class="hover:text-blue-400 transition-colors">
                  {category.name}
                </a>
              </li>
            ))
          ) : (
            <>
              <li><a href="/applications" class="hover:text-blue-400 transition-colors">View All Applications</a></li>
            </>
          )}
        </ul>
      </div>

      <!-- ADDRESS & CONTACT 列 -->
      <div class="md:col-span-5 flex flex-col gap-6">
        <div>
          <h3 class="text-white font-bold text-sm tracking-widest uppercase mb-2">ADDRESS</h3>
          <p class="text-xs text-gray-400 leading-relaxed">
            Zhejiang Rongchang Tools Co., Ltd.<br>
            No. 123 Industrial Park, Yongkang City<br>
            Zhejiang Province, China
          </p>
        </div>

        <div class="grid grid-cols-2 gap-6">
          <div>
            <h3 class="text-white font-bold text-sm tracking-widest uppercase mb-2">EMAIL</h3>
            <div class="flex flex-col gap-1 text-xs text-gray-400">
              <a href="mailto:info@example.com" class="hover:text-blue-400 transition-colors">info@example.com</a>
              <a href="mailto:sales@example.com" class="hover:text-blue-400 transition-colors">sales@example.com</a>
            </div>
          </div>

          <div>
            <h3 class="text-white font-bold text-sm tracking-widest uppercase mb-2">PHONE</h3>
            <div class="flex flex-col gap-1 text-xs text-gray-400">
              <a href="tel:+8618858079359" class="hover:text-blue-400 transition-colors">+86 18858079359</a>
              <a href="tel:+8617681630603" class="hover:text-blue-400 transition-colors">+86 17681630603</a>
            </div>
          </div>
        </div>
      </div>

    </div>

    <div class="mt-14 pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between text-[11px] font-mono text-gray-500 gap-4">
      <div>© 2026 Zhejiang Rongchang Tools Co., Ltd. All rights reserved.</div>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-gray-300 transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-gray-300 transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
