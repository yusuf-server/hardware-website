---
import { getProductCategories, getApplicationCategories } from '@/lib/wordpress';

// 获取产品分类（只获取一级分类）
let productCategories = [];
try {
  const allCategories = await getProductCategories();
  productCategories = allCategories.filter(cat => cat.parent === 0).slice(0, 6); // 最多显示6个
} catch (e) {
  console.error('Error fetching product categories:', e);
}

// 获取应用领域分类（只获取一级分类）
let applicationCategories = [];
try {
  const allCategories = await getApplicationCategories();
  applicationCategories = allCategories.filter(cat => cat.parent === 0).slice(0, 6); // 最多显示6个
} catch (e) {
  console.error('Error fetching application categories:', e);
}
---

<!-- Header -->
<header class="header-bold fixed top-0 left-0 w-full z-50 flex items-center justify-between px-8 py-5 backdrop-blur-md bg-[#06080d]/70 border-b border-white/10">
  <a href="/" class="flex items-center">
    <img src="https://darkgrey-woodcock-712173.hostingersite.com/wp-content/uploads/2026/09/1-1.png" alt="Logo" class="h-12 w-auto" />
  </a>

  <nav class="hidden md:flex items-center gap-8 text-sm text-gray-400 font-bold" style="font-family: 'Inter-Bold', 'Inter', sans-serif; font-weight: 700;">
    <a href="/" class="hover:text-white transition-colors duration-200">Home</a>
    <a href="/about" class="hover:text-white transition-colors duration-200">About</a>

    <!-- Products with Dropdown -->
    <div class="relative group">
      <a href="/products" class="hover:text-white transition-colors duration-200 flex items-center gap-1">
        Products
        <i data-lucide="chevron-down" class="w-3 h-3"></i>
      </a>

      {productCategories.length > 0 && (
        <div class="absolute top-full left-0 mt-2 w-56 backdrop-blur-md bg-[#06080d]/90 rounded-lg shadow-xl border border-white/10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 overflow-hidden">
          <div class="py-2">
            {productCategories.map((category) => (
              <a
                href={`/products#category-${category.id}`}
                class="block px-4 py-2.5 text-gray-300 hover:bg-white/5 hover:text-white transition-colors text-sm"
              >
                {category.name}
              </a>
            ))}
            <div class="border-t border-white/10 mt-2 pt-2">
              <a
                href="/products"
                class="block px-4 py-2.5 text-blue-400 hover:bg-white/5 hover:text-blue-300 transition-colors text-sm"
              >
                View All Products →
              </a>
            </div>
          </div>
        </div>
      )}
    </div>

    <!-- Applications with Dropdown -->
    <div class="relative group">
      <a href="/applications" class="hover:text-white transition-colors duration-200 flex items-center gap-1">
        Applications
        <i data-lucide="chevron-down" class="w-3 h-3"></i>
      </a>

      {applicationCategories.length > 0 && (
        <div class="absolute top-full left-0 mt-2 w-56 backdrop-blur-md bg-[#06080d]/90 rounded-lg shadow-xl border border-white/10 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 overflow-hidden">
          <div class="py-2">
            {applicationCategories.map((category) => (
              <a
                href={`/applications#category-${category.id}`}
                class="block px-4 py-2.5 text-gray-300 hover:bg-white/5 hover:text-white transition-colors text-sm"
              >
                {category.name}
              </a>
            ))}
            <div class="border-t border-white/10 mt-2 pt-2">
              <a
                href="/applications"
                class="block px-4 py-2.5 text-blue-400 hover:bg-white/5 hover:text-blue-300 transition-colors text-sm"
              >
                View All Applications →
              </a>
            </div>
          </div>
        </div>
      )}
    </div>

    <a href="/news" class="hover:text-white transition-colors duration-200">News</a>
    <a href="/contact" class="hover:text-white transition-colors duration-200">Contact</a>
  </nav>

  <div class="flex items-center gap-4">
    <button class="flex items-center gap-1.5 text-xs text-gray-300 hover:text-white px-3 py-1.5 rounded-full border border-white/10 hover:border-white/20 transition-all">
      <i data-lucide="globe" class="w-3.5 h-3.5"></i>
      <span>EN</span>
    </button>
    <a href="/#section-6" class="text-xs px-5 py-2.5 rounded-full bg-blue-600 hover:bg-blue-700 text-white shadow-lg shadow-blue-500/25 transition-all">
      Get Quote
    </a>
  </div>
</header>

<style>
  /* 针对 Header 内所有文字元素全局生效 Inter-Bold */
  header,
  header a,
  header button,
  header span {
    font-family: 'Inter-Bold', sans-serif !important;
    font-weight: 700 !important;
  }
</style>